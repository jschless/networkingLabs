# LDAP module — authenticate/authorize users against Active Directory (dc1).
#
# AD rejects cleartext binds, so we use ldaps:// (AD's self-signed cert; the
# container's join script set SASL_NOCANON + tls require_cert never).
ldap {
    server = 'ldaps://dc1.lab.corp'
    identity = 'cn=Administrator,cn=Users,dc=lab,dc=corp'
    password = 'P@ssw0rd1'
    base_dn = 'dc=lab,dc=corp'

    update {
        control:Password-With-Header    += 'userPassword'
        control:NT-Password             := 'ntPassword'
        reply:Reply-Message             := 'radiusReplyMessage'
    }

    user {
        # Seeded employees live in OU=Employees; match on sAMAccountName.
        base_dn = "OU=Employees,${..base_dn}"
        filter = "(sAMAccountName=%{%{Stripped-User-Name}:-%{User-Name}})"
    }

    group {
        # Security groups live in CN=Users; membership is the user's memberOf.
        base_dn = "CN=Users,${..base_dn}"
        filter = '(objectClass=group)'
        membership_attribute = 'memberOf'
    }

    options {
        chase_referrals = no
        rebind = no
    }

    tls {
        require_cert = 'never'
    }

    pool {
        start = 1
        min = 1
        max = 5
        spare = 1
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }
}
