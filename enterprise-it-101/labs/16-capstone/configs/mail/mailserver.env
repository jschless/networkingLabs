# docker-mailserver configuration (GIVEN scaffolding).
#
# This file wires the mail server to Active Directory. The LDAP env is verbose
# and unforgiving — exactly the kind of one-time plumbing the lab hands you so
# you can focus on the *concepts*: AD-backed mailboxes, MX, TLS, DKIM, spam.
# Read it; you'll understand every line by the end, and you'll deliberately
# break one value (LDAP_BIND_PW) in the final task.

# --- Identity: mailboxes come from AD, not a local account file ---
ACCOUNT_PROVISIONER=LDAP
PERMIT_DOCKER=connected-networks

# --- TLS for SMTP/IMAP (a self-signed cert for mail1.lab.corp) ---
SSL_TYPE=manual
SSL_CERT_PATH=/tmp/dms/custom-certs/mail1.crt
SSL_KEY_PATH=/tmp/dms/custom-certs/mail1.key

# --- Bind to AD over LDAPS. AD rejects cleartext simple binds, so we use
#     ldaps://. AD's auto-generated cert is self-signed and has no SAN, so
#     user-patches.sh relaxes cert verification (channel still encrypted). ---
LDAP_SERVER_HOST=ldaps://dc1.lab.corp
LDAP_SEARCH_BASE=dc=lab,dc=corp
LDAP_BIND_DN=cn=Administrator,cn=Users,dc=lab,dc=corp
LDAP_BIND_PW=P@ssw0rd1

# --- How Postfix finds a recipient / domain / alias in AD ---
LDAP_QUERY_FILTER_USER=(&(objectClass=user)(mail=%s))
LDAP_QUERY_FILTER_GROUP=(&(objectClass=group)(mail=%s))
LDAP_QUERY_FILTER_ALIAS=(&(objectClass=user)(otherMailbox=%s))
LDAP_QUERY_FILTER_DOMAIN=(mail=*@%s)

# --- How Dovecot authenticates a login. AD never reveals password hashes, so
#     Dovecot must *bind as the user* to verify the password (auth-bind). AD
#     users have no uidNumber, so we pin the mailbox to the vmail uid (5000). ---
DOVECOT_AUTH_BIND=yes
DOVECOT_USER_FILTER=(&(objectClass=user)(mail=%u))
DOVECOT_PASS_FILTER=(&(objectClass=user)(mail=%u))
DOVECOT_USER_ATTRS==uid=5000,=gid=5000,=home=/var/mail/%Ln/,=mail=maildir:/var/mail/%Ln/Maildir

# --- Security services ---
ENABLE_SPAMASSASSIN=1
SPAMASSASSIN_SPAM_TO_INBOX=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
LOG_LEVEL=info
