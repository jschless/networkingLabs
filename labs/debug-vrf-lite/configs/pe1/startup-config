! pe1 — Provider Edge  (Arista EOS)
!
hostname pe1
!
vrf instance VRF-RED
!
vrf instance VRF-BLUE
!
interface Loopback0
   ip address 192.168.0.1/32
!
interface Ethernet1
   description to ce-a1
   no switchport
   vrf VRF-BLUE
   ip address 10.10.12.2/30
   no shutdown
!
interface Ethernet2
   description to pe2 RED inter-PE
   no switchport
   vrf VRF-RED
   ip address 10.10.99.1/30
   no shutdown
!
interface Ethernet3
   description to ce-b1
   no switchport
   vrf VRF-BLUE
   ip address 10.20.12.2/30
   no shutdown
!
interface Ethernet4
   description to pe2 BLUE inter-PE
   no switchport
   vrf VRF-BLUE
   ip address 10.20.99.1/30
   no shutdown
!
ip routing
ip routing vrf VRF-RED
ip routing vrf VRF-BLUE
!
ip route vrf VRF-RED  10.10.0.1/32 10.10.12.1
ip route vrf VRF-RED  10.10.0.2/32 10.10.99.2
ip route vrf VRF-BLUE 10.20.0.1/32 10.20.12.1
ip route vrf VRF-BLUE 10.20.0.2/32 10.20.99.2
!
end
