! gw-b — Site B gateway baseline (Arista EOS)
! Physical and loopback addressing only; the learner builds the overlay.
hostname gw-b
!
interface Loopback0
   ip address 10.0.0.2/32
!
interface Ethernet1
   description to internet WAN-B
   no switchport
   ip address 203.0.113.6/30
   no shutdown
!
interface Ethernet2
   description to host-b LAN-B
   no switchport
   ip address 192.168.2.1/24
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 203.0.113.5
!
end
