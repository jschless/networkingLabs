! gw-a — Site A gateway baseline (Arista EOS)
! Physical and loopback addressing only; the learner builds the overlay.
hostname gw-a
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to host-a LAN-A
   no switchport
   ip address 192.168.1.1/24
   no shutdown
!
interface Ethernet2
   description to internet WAN-A
   no switchport
   ip address 203.0.113.1/30
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 203.0.113.2
!
end
