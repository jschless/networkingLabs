hostname r3
!
ip routing
!
interface Loopback0
   ip address 10.0.0.3/32
!
interface Ethernet1
   description to r2:eth2
   no switchport
   ip address 10.1.23.2/30
!
interface Ethernet2
   description to r4:eth1
   no switchport
   ip address 10.1.34.1/30
!
! ============================================================
! YOUR TASKS ON R3
! ============================================================
!
! TASK 1 — Base BGP
!   configure
!   router bgp 65003
!      bgp router-id 10.0.0.3
!      neighbor 10.1.23.1 remote-as 65002
!      neighbor 10.1.34.2 remote-as 65004
!      !
!      address-family ipv4
!         neighbor 10.1.23.1 activate
!         neighbor 10.1.34.2 activate
!         network 10.0.0.3/32
!      !
!
! TASK 2 — AS-path filter: only accept prefixes from AS65001
!   AS-path access-lists use POSIX-style regular expressions.
!
!   ip as-path access-list ONLY-65001 permit _65001$
!
!   Regex breakdown:
!     _65001$  = AS65001 appears at the end of the AS-path
!                (i.e., 65001 is the origin AS)
!     _        = matches a separator: start-of-string, space, or end-of-string
!     $        = end of string
!
!   For a route originated in AS65001 traveling through AS65002,
!   the AS-path arriving at r3 is: "65002 65001"
!   The pattern _65001$ matches "65001" at the end → permit.
!
!   NOTE: EOS has no "neighbor filter-list". Use a route-map instead:
!   route-map ASPATH-IN permit 10
!      match as-path ONLY-65001
!   router bgp 65003
!      address-family ipv4
!         neighbor 10.1.23.1 route-map ASPATH-IN in
!      !
!
!   After: clear bgp neighbors 10.1.23.1 soft-inbound
!   r3 should now only accept routes with AS65001 as origin.
!   r2's own loopback (10.0.0.2/32, AS-path "65002") would be blocked.
!
! TASK 3 — AS-path filter: block routes transiting a specific AS
!   Block any route that has passed through AS65002:
!
!   ip as-path access-list BLOCK-65002 deny _65002_
!   ip as-path access-list BLOCK-65002 permit .*
!
!   _65002_ matches AS65002 anywhere in the AS-path (as an AS hop, not a substring).
!   The final permit .* allows everything else.
!
!   NOTE: EOS has no "neighbor filter-list" — always apply via route-map:
!   route-map ASPATH-FILTER deny 10
!      match as-path BLOCK-65002
!   route-map ASPATH-FILTER permit 20
!
! TASK 4 — AS-path filter: only accept locally-originated
!   ip as-path access-list SELF-ONLY permit ^$
!
!   ^$ matches an empty AS-path — meaning the route was originated locally
!   by the router you're receiving from (no transits). Useful to ensure
!   a peer only sends you their own prefixes.
!
! TASK 5 — Outbound AS-path filter on r3
!   Filter what r3 sends to r4: only allow routes with AS65001 origin.
!
!   ip as-path access-list FROM-65001 permit _65001$
!   route-map ASPATH-OUT permit 10
!      match as-path FROM-65001
!   router bgp 65003
!      address-family ipv4
!         neighbor 10.1.34.2 route-map ASPATH-OUT out
!      !
! ============================================================
end
