hostname r1
!
ip routing
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Loopback1
   ip address 172.16.1.1/24
!
interface Loopback2
   ip address 172.16.2.1/24
!
interface Ethernet1
   description to r2:eth1
   no switchport
   ip address 10.1.12.1/30
!
! ============================================================
! YOUR TASKS ON R1
! ============================================================
!
! TASK 1 — Base BGP with all prefixes advertised
!   Advertise the loopback and both /24 prefixes.
!
!   configure
!   router bgp 65001
!      bgp router-id 10.0.0.1
!      neighbor 10.1.12.2 remote-as 65002
!      !
!      address-family ipv4
!         neighbor 10.1.12.2 activate
!         network 10.0.0.1/32
!         network 172.16.1.0/24
!         network 172.16.2.0/24
!      !
!
!   Verify on r2: show bgp ipv4 unicast
!   r2 should see all three prefixes from r1.
!
! TASK 2 — Outbound prefix-list filter on r1
!   Limit what r1 advertises to r2. Only send the loopback; suppress
!   both /24s. The prefix-list acts as an outbound advertisement filter.
!
!   ip prefix-list ADVERTISE-ONLY-LO seq 5 permit 10.0.0.1/32
!   ip prefix-list ADVERTISE-ONLY-LO seq 10 deny 0.0.0.0/0 le 32
!
!   router bgp 65001
!      address-family ipv4
!         neighbor 10.1.12.2 prefix-list ADVERTISE-ONLY-LO out
!      !
!
!   After: clear bgp * soft-outbound
!   Verify on r2: 172.16.1.0/24 and 172.16.2.0/24 should be GONE.
!
! TASK 3 — Selective outbound: allow one /24 but not the other
!   ip prefix-list SELECTIVE-OUT seq 5 permit 10.0.0.1/32
!   ip prefix-list SELECTIVE-OUT seq 10 permit 172.16.1.0/24
!   ip prefix-list SELECTIVE-OUT seq 15 deny 0.0.0.0/0 le 32
!
!   This allows 172.16.1.0/24 through but blocks 172.16.2.0/24.
!
! TIP: Prefix-list evaluation is sequential. First match wins.
!      A prefix-list with no matching entry has an implicit deny-all.
! ============================================================
end
