hostname r3
!
ip routing
!
interface Loopback0
   ip address 10.0.0.3/32
!
interface Ethernet1
   description to r2 (AS65002) — iBGP
   no switchport
   ip address 10.1.23.2/30
!
interface Ethernet2
   description to r4 (AS65003) — eBGP
   no switchport
   ip address 10.1.34.1/30
!
router bgp 65002
   bgp router-id 10.0.0.3
   neighbor 10.1.23.1 remote-as 65002
   neighbor 10.1.34.2 remote-as 65003
   !
   address-family ipv4
      neighbor 10.1.23.1 activate
      neighbor 10.1.34.2 activate
      neighbor 10.1.34.2 next-hop-self
      network 10.0.0.3/32
   !
!
end
