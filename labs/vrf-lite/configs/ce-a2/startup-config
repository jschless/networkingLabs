! ce-a2 — Customer A Site 2  (Arista EOS acting as CE router)
! IP: 10.10.34.2/30,  loopback: 10.10.0.2/32
! Default route toward pe2 VRF-RED interface (10.10.34.1)
!
hostname ce-a2
!
interface Loopback0
   ip address 10.10.0.2/32
!
interface Ethernet1
   description to pe2 (VRF-RED)
   no switchport
   ip address 10.10.34.2/30
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 10.10.34.1
!
end
