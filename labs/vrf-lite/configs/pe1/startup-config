! pe1 — Provider Edge  (Arista EOS)
! VRF-RED:  serves Customer A (ce-a1 ↔ ce-a2)
! VRF-BLUE: serves Customer B (ce-b1 ↔ ce-b2)
!
! Interface addressing:
!   Ethernet1  to ce-a1  10.10.12.2/30  VRF-RED
!   Ethernet2  to pe2    10.10.99.1/30  VRF-RED  (inter-PE)
!   Ethernet3  to ce-b1  10.20.12.2/30  VRF-BLUE
!   Ethernet4  to pe2    10.20.99.1/30  VRF-BLUE (inter-PE)
!
! ═══════════════════════════════════════════════════════════════
! TASK 1  Create VRF instances
!   vrf instance VRF-RED
!   vrf instance VRF-BLUE
!
! TASK 2  Enable IP routing inside each VRF
!   ip routing vrf VRF-RED
!   ip routing vrf VRF-BLUE
!
! TASK 3  Assign interfaces to VRFs and configure IPs
!   Note: the vrf assignment must come before the ip address command.
!
!   interface Ethernet1
!      no switchport
!      vrf VRF-RED
!      ip address 10.10.12.2/30
!      no shutdown
!   interface Ethernet2
!      no switchport
!      vrf VRF-RED
!      ip address 10.10.99.1/30
!      no shutdown
!   interface Ethernet3
!      no switchport
!      vrf VRF-BLUE
!      ip address 10.20.12.2/30
!      no shutdown
!   interface Ethernet4
!      no switchport
!      vrf VRF-BLUE
!      ip address 10.20.99.1/30
!      no shutdown
!
! TASK 4  Add static routes within each VRF
!   ip route vrf VRF-RED  10.10.0.1/32 10.10.12.1    ! ce-a1 loopback
!   ip route vrf VRF-RED  10.10.0.2/32 10.10.99.2    ! ce-a2 loopback (via pe2)
!   ip route vrf VRF-BLUE 10.20.0.1/32 10.20.12.1    ! ce-b1 loopback
!   ip route vrf VRF-BLUE 10.20.0.2/32 10.20.99.2    ! ce-b2 loopback (via pe2)
! ═══════════════════════════════════════════════════════════════
!
hostname pe1
!
interface Loopback0
   ip address 192.168.0.1/32
!
ip routing
!
end
