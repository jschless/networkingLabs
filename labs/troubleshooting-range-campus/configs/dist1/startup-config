hostname dist1
!
ip routing
!
spanning-tree mode rstp
spanning-tree priority 4096
!
vlan 10
   name CORPORATE
!
vlan 20
   name VOICE
!
interface Port-Channel1
   description to-acc1 LACP campus trunk
   switchport mode trunk
   switchport trunk allowed vlan 10,20
   no shutdown
!
interface Ethernet1
   description to-acc1 bundle member 1
   channel-group 1 mode active
   no shutdown
!
interface Ethernet2
   description to-acc1 bundle member 2
   channel-group 1 mode active
   no shutdown
!
interface Ethernet3
   description to-dhcp1 trusted service edge
   switchport mode access
   switchport access vlan 10
   spanning-tree portfast
   no shutdown
!
interface Vlan10
   ip address 10.252.10.1/24
   no shutdown
!
interface Vlan20
   ip address 10.252.20.1/24
   no shutdown
!
end
