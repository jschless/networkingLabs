hostname edge
ip routing
ipv6 unicast-routing
interface Ethernet1
   no switchport
   ip address 10.108.105.2/30
   ipv6 address 2001:db8:108:105::2/64
   ip ospf area 0
   ip ospf network point-to-point
   ipv6 ospf 108 area 0
   ipv6 ospf network point-to-point
interface Ethernet2
   no switchport
   ip address 10.108.102.2/30
   ipv6 address 2001:db8:108:102::2/64
   ip ospf area 0
   ip ospf network point-to-point
   ipv6 ospf 108 area 0
   ipv6 ospf network point-to-point
interface Ethernet3
   no switchport
   ip address 198.18.108.1/24
   ipv6 address 2001:db8:ffff:108::1/64
ip route 10.108.0.0/16 Null0
ipv6 route 2001:db8:108::/48 Null0
router ospf 108
   router-id 10.108.255.3
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet2
ipv6 router ospf 108
   router-id 10.108.255.3
router bgp 65108
   router-id 10.108.255.3
   neighbor 198.18.108.2 remote-as 65000
   neighbor 2001:db8:ffff:108::2 remote-as 65000
   address-family ipv4
      neighbor 198.18.108.2 activate
      network 10.108.0.0/16
   address-family ipv6
      neighbor 2001:db8:ffff:108::2 activate
      network 2001:db8:108::/48
end
