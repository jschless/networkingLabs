hostname ext
!
ip routing
!
! -------------------------------------------------------------------
! ext — External Host (not part of OSPF)
!
! ext simulates an external network reachable from OSPF via r1.
! It does NOT run OSPF. r1 redistributes the 192.168.100.0/30
! subnet into OSPF as an external route.
!
! ext has a static default route pointing to r1 so it can reply
! to pings from r3.
!
! Ethernet1: connects to r1 (192.168.100.0/30, ext=.2)
! Loopback0:   using ext's address 192.168.100.2 (already on Ethernet1 as /30)
! -------------------------------------------------------------------

interface Ethernet1
 no switchport
 description to-r1 (external segment, not in OSPF)
 ip address 192.168.100.2/30

! Static default route toward r1 so ext can return traffic
ip route 0.0.0.0/0 192.168.100.1

! -------------------------------------------------------------------
! ext does NOT run OSPF. No OSPF configuration needed.
!
! Verify:
!   ping 192.168.100.1   <- r1's interface on this segment
!
! From r3 (after full OSPF NSSA setup):
!   ping 192.168.100.2 source 10.0.0.3
!   -> r3 has 192.168.100.0/30 as O E2 via the Type-5 LSA
!   -> ext returns traffic via static default to r1 to r2 to r3
! -------------------------------------------------------------------
