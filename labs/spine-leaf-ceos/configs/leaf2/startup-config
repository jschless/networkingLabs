! leaf2 — AS65002  (Arista EOS)
!
! YOUR TASK: Configure BGP AS65002.
!
! router bgp 65002
!    router-id 10.0.0.2
!    maximum-paths 2 ecmp 2
!    bgp bestpath as-path multipath-relax
!    neighbor 10.1.0.3 remote-as 65100
!    neighbor 10.2.0.3 remote-as 65200
!    !
!    address-family ipv4
!       neighbor 10.1.0.3 activate
!       neighbor 10.2.0.3 activate
!       network 10.0.0.2/32
!
hostname leaf2
!
interface Loopback0
   ip address 10.0.0.2/32
!
interface Ethernet1
   description to spine1  10.1.0.2/31
   ip address 10.1.0.2/31
   no shutdown
!
interface Ethernet2
   description to spine2  10.2.0.2/31
   ip address 10.2.0.2/31
   no shutdown
!
ip routing
!
end
