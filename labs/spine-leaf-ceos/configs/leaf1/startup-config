! leaf1 — AS65001  (Arista EOS)
!
! Interface IPs are pre-configured.
! YOUR TASK: Configure BGP AS65001 with dual uplinks to spine1 and spine2.
!
! router bgp 65001
!    router-id 10.0.0.1
!    maximum-paths 2 ecmp 2
!    bgp bestpath as-path multipath-relax
!    neighbor 10.1.0.1 remote-as 65100
!    neighbor 10.2.0.1 remote-as 65200
!    !
!    address-family ipv4
!       neighbor 10.1.0.1 activate
!       neighbor 10.2.0.1 activate
!       network 10.0.0.1/32
!
hostname leaf1
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to spine1  10.1.0.0/31
   no switchport
   ip address 10.1.0.0/31
   no shutdown
!
interface Ethernet2
   description to spine2  10.2.0.0/31
   no switchport
   ip address 10.2.0.0/31
   no shutdown
!
ip routing
!
end
