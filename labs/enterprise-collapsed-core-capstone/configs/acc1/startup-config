! acc1 — access layer switch #1  (Arista EOS)
!
! Pure L2 switch. No ip routing.
! Uplink to cc1 (trunk). Downlink to client-a (VLAN 10 access).
!
hostname acc1
!
spanning-tree mode rstp
!
vlan 10
   name corporate
!
vlan 20
   name voice
!
vlan 30
   name guest
!
vlan 99
   name management
!
interface Ethernet1
   description to-cc1-trunk
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
interface Ethernet2
   description to-client-a  access-vlan10
   switchport access vlan 10
   switchport mode access
   no shutdown
!
! ================================================
! acc1  —  Capstone Tasks
!
! Task 1 — STP PortFast on client-facing port
!   Enable portfast on Ethernet2 so client-a transitions immediately.
!   Hint (under interface Ethernet2):
!     spanning-tree portfast
! ================================================
!
end
