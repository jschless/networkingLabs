! spoke1 — DMVPN spoke router  (Arista EOS)
!
! Physical IPs and Tunnel0 interface are pre-configured.
! YOUR TASK: Configure NHRP registration and OSPF.
!
! -------------------------------------------------------
! Step 1 — Configure NHRP on Tunnel0:
!   configure
!   interface Tunnel0
!      ip nhrp network-id 1
!      ip nhrp holdtime 300
!      ip nhrp nhs 172.16.0.1 nbma 10.0.0.1 multicast
!      ip nhrp map 172.16.0.1 10.0.0.1
!      ip nhrp registration no-unique
!      ip ospf network point-to-point
!      ip ospf area 0
!
! Step 2 — Configure OSPF process:
!   router ospf 1
!      router-id 10.0.0.11
!      passive-interface Loopback0
!      passive-interface Loopback1
!
! Step 3 — Verify:
!   show ip nhrp               ← should show hub mapping
!   show ip ospf neighbor      ← should show hub as Full neighbor
!   ping 172.16.0.1            ← hub tunnel IP
!   ping 192.168.2.1           ← spoke2 LAN (after spoke2 is configured)
!
! NHRP parameters:
!   NHS (Next Hop Server) tunnel IP: 172.16.0.1
!   NHS NBMA (WAN) IP:               10.0.0.1
!   Our tunnel IP:                   172.16.0.11
! -------------------------------------------------------
!
hostname spoke1
!
interface Loopback0
   ip address 10.0.0.11/32
!
interface Loopback1
   description Simulated LAN behind spoke1
   ip address 192.168.1.1/24
!
interface Ethernet1
   description WAN NBMA network (10.0.0.0/24)
   ip address 10.0.0.11/24
   no shutdown
!
interface Tunnel0
   description DMVPN GRE tunnel to hub
   tunnel source Ethernet1
   tunnel mode gre multipoint
   ip address 172.16.0.11/24
   no shutdown
   ! YOUR TASK: Add NHRP and OSPF config here (see hints above)
!
ip routing
!
end
