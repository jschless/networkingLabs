! core1 — AS65300 internal core router  (Arista EOS)
! Role: primary campus/DC core, directly connected to server subnet
!
! Links:
!   Ethernet1: 10.255.1.2/30   (to edge)
!   Ethernet2: 10.255.3.1/30   (to core2)
!   Ethernet3: 10.100.0.1/30   (to server)
!   Loopback0: 10.0.0.2/32
!
hostname core1
!
interface Loopback0
   ip address 10.0.0.2/32
!
interface Ethernet1
   description to-edge  10.255.1.0/30
   no switchport
   ip address 10.255.1.2/30
   no shutdown
!
interface Ethernet2
   description to-core2  10.255.3.0/30
   no switchport
   ip address 10.255.3.1/30
   no shutdown
!
interface Ethernet3
   description to-server  10.100.0.0/30
   no switchport
   ip address 10.100.0.1/30
   no shutdown
!
ip routing
!
! ================================================
! core1  —  Capstone Tasks
!
! Role: Core OSPF area 0 router — propagates internet default to server subnet
!
! Task 1 — OSPF Area 0
!   All 3 Ethernet interfaces active. Advertise loopback + all 3 links in area 0.
!   The server subnet (Ethernet3) goes in area 0 — no ABR needed here.
!   Hint:
!     router ospf 1
!        router-id 10.0.0.2
!        passive-interface default
!        no passive-interface Ethernet1
!        no passive-interface Ethernet2
!        network 10.0.0.2/32 area 0.0.0.0
!        network 10.255.1.0/30 area 0.0.0.0
!        network 10.255.3.0/30 area 0.0.0.0
!        network 10.100.0.0/30 area 0.0.0.0
! ================================================
!
end
