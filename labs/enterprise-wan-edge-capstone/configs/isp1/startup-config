! isp1 — AS65100  (Arista EOS) — fully configured, do not modify
hostname isp1
!
interface Loopback0
   ip address 1.1.1.1/32
!
interface Ethernet1
   description to-edge  203.0.113.0/30
   no switchport
   ip address 203.0.113.1/30
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 Null0
!
router bgp 65100
   router-id 1.1.1.1
   no bgp ebgp-requires-policy
   neighbor 203.0.113.2 remote-as 65300
   neighbor 203.0.113.2 description edge-primary
   !
   address-family ipv4
      neighbor 203.0.113.2 activate
      network 0.0.0.0/0
      network 1.1.1.1/32
!
end
