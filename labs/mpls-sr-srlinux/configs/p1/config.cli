# p1 — Provider core router  (Nokia SR-Linux)
# IS-IS level-2 only, SR-MPLS node SID index 4 (label 16004)
# No BGP — pure MPLS forwarding

enter candidate

    /interface system0
        admin-state enable
        subinterface 0
            admin-state enable
            ipv4
                admin-state enable
                address 10.0.0.4/32 { }

    /interface ethernet-1/1
        description "to PE1"
        admin-state enable
        subinterface 0
            admin-state enable
            ipv4
                admin-state enable
                address 10.1.0.2/30 { }

    /interface ethernet-1/2
        description "to RR1"
        admin-state enable
        subinterface 0
            admin-state enable
            ipv4
                admin-state enable
                address 10.1.0.5/30 { }

    /interface ethernet-1/3
        description "to P2"
        admin-state enable
        subinterface 0
            admin-state enable
            ipv4
                admin-state enable
                address 10.1.0.13/30 { }

    /network-instance default
        interface ethernet-1/1.0 { }
        interface ethernet-1/2.0 { }
        interface ethernet-1/3.0 { }
        interface system0.0 { }

        protocols
            isis
                instance main
                    admin-state enable
                    level-capability L2
                    net [ "49.0001.0000.0000.0004.00" ]

                    interface ethernet-1/1.0
                        circuit-type point-to-point
                        ipv4-unicast
                            admin-state enable
                        level 2
                            metric 10

                    interface ethernet-1/2.0
                        circuit-type point-to-point
                        ipv4-unicast
                            admin-state enable
                        level 2
                            metric 10

                    interface ethernet-1/3.0
                        circuit-type point-to-point
                        ipv4-unicast
                            admin-state enable
                        level 2
                            metric 10

                    interface system0.0
                        passive true
                        ipv4-unicast
                            admin-state enable

                    segment-routing
                        mpls
                            admin-state enable
                            prefix-sids
                                prefix 10.0.0.4/32
                                    _idx 0
                                    index 4
                                    node-sid true
                            dynamic-adjacency-sids
                                all-interfaces true

    /routing-policy
        policy accept-all
            default-action
                policy-result accept

commit now
