# rr1 — Route Reflector  (Nokia SR-Linux)
# IS-IS level-2, SR-MPLS node SID index 1 (label 16001)
# BGP Route Reflector for L3VPN (ipv4-vpn / VPNv4) clients pe1 and pe2

enter candidate

    /interface system0
        admin-state enable
        subinterface 0
            admin-state enable
            ipv4
                admin-state enable
                address 10.0.0.1/32 { }

    /interface ethernet-1/1
        description "to P1"
        admin-state enable
        subinterface 0
            admin-state enable
            ipv4
                admin-state enable
                address 10.1.0.6/30 { }

    /interface ethernet-1/2
        description "to P2"
        admin-state enable
        subinterface 0
            admin-state enable
            ipv4
                admin-state enable
                address 10.1.0.9/30 { }

    /network-instance default
        interface ethernet-1/1.0 { }
        interface ethernet-1/2.0 { }
        interface system0.0 { }

        protocols
            isis
                instance main
                    admin-state enable
                    level-capability L2
                    metric-style wide
                    net [ "49.0001.0000.0000.0001.00" ]

                    interface ethernet-1/1.0
                        circuit-type point-to-point
                        ipv4-unicast
                            admin-state enable
                        level 2
                            metric 10

                    interface ethernet-1/2.0
                        circuit-type point-to-point
                        ipv4-unicast
                            admin-state enable
                        level 2
                            metric 10

                    interface system0.0
                        passive true
                        ipv4-unicast
                            admin-state enable

                    segment-routing
                        mpls
                            admin-state enable
                            prefix-sids
                                prefix 10.0.0.1/32
                                    _idx 0
                                    index 1
                                    node-sid true
                            dynamic-adjacency-sids
                                all-interfaces true

            bgp
                admin-state enable
                autonomous-system 65000
                router-id 10.0.0.1

                afi-safi ipv4-unicast
                    admin-state disable

                afi-safi l3vpn-ipv4-unicast
                    admin-state enable

                group ibgp-rrc
                    admin-state enable
                    peer-as 65000
                    route-reflector
                        client true
                        cluster-id 10.0.0.1
                    afi-safi ipv4-unicast
                        admin-state disable
                    afi-safi l3vpn-ipv4-unicast
                        admin-state enable
                    transport
                        local-address 10.0.0.1
                    export-policy [ accept-all ]
                    import-policy [ accept-all ]

                neighbor 10.0.0.2
                    peer-group ibgp-rrc
                    description pe1

                neighbor 10.0.0.3
                    peer-group ibgp-rrc
                    description pe2

    /routing-policy
        policy accept-all
            default-action
                policy-result accept

commit now
