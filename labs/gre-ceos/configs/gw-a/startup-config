! gw-a — Site A gateway  (Arista EOS)
!
! Physical interfaces are pre-configured below.
! YOUR TASK: Configure Tunnel0 and add a route to LAN B.
!
! -------------------------------------------------------
! Step 1 — Enter the EOS CLI:
!   docker exec -it clab-gre-ceos-gw-a Cli
!
! Step 2 — Configure the GRE tunnel:
!   configure
!   interface Tunnel0
!      tunnel source Ethernet2
!      tunnel destination 203.0.113.6
!      ip address 172.16.0.1/30
!      no shutdown
!
! Step 3 — Add a static route to LAN B:
!   ip route 192.168.2.0/24 172.16.0.2
!
! Step 4 — Verify:
!   show interfaces Tunnel0
!   show ip route
!   ping 172.16.0.2              ← gw-b tunnel endpoint
!   ping 192.168.2.10            ← host-b (after adding route on gw-b too)
!
! GRE tunnel parameters:
!   Tunnel source:      Ethernet2  (203.0.113.1 — our WAN IP)
!   Tunnel destination: 203.0.113.6 (gw-b WAN IP)
!   Tunnel IP:          172.16.0.1/30
! -------------------------------------------------------
!
hostname gw-a
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to host-a LAN-A
   no switchport
   ip address 192.168.1.1/24
   no shutdown
!
interface Ethernet2
   description to internet WAN-A
   no switchport
   ip address 203.0.113.1/30
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 203.0.113.2
!
end
