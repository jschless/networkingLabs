! dist2  (Arista EOS)
!
! Distribution layer — OSPF ABR (area 0 + area 1), VRRP gateway, STP root.
! Loopback: 10.0.0.5/32
!
! VRRP roles:
!   VLAN 10 (corporate): BACKUP  — priority 100 (dist1 wins)
!   VLAN 20 (voice):     ACTIVE  — priority 120 (wins)
!   VLAN 30 (guest):     BACKUP  — priority 100 (dist1 wins)
!
! STP roles:
!   VLAN 20:      PRIMARY root   — priority 4096
!   VLAN 10, 30:  SECONDARY root — priority 8192
!
hostname dist2
!
ip routing
!
spanning-tree mode rstp
spanning-tree vlan-id 20 priority 4096
spanning-tree vlan-id 10 priority 8192
spanning-tree vlan-id 30 priority 8192
spanning-tree vlan-id 99 priority 8192
!
vlan 10,20,30,99
!
interface Loopback0
   description router-id
   ip address 10.0.0.5/32
!
! Routed uplinks to core (no switchport)
interface Ethernet1
   description to-core1  10.0.14.0/30
   no switchport
   ip address 10.0.14.2/30
   no shutdown
!
interface Ethernet2
   description to-core2  10.0.24.0/30
   no switchport
   ip address 10.0.24.2/30
   no shutdown
!
! Trunk downlinks to access switches (L2 — no "no switchport")
interface Ethernet3
   description to-acc3  trunk
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
interface Ethernet4
   description to-acc4  trunk
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
! VLAN SVIs — OSPF passive, VRRP virtual IPs
interface Vlan10
   description corporate-10.10.10.0/24
   ip address 10.10.10.3/24
   vrrp 10 ip 10.10.10.1
   vrrp 10 priority 100
   vrrp 10 preempt
   no shutdown
!
interface Vlan20
   description voice-10.20.20.0/24
   ip address 10.20.20.3/24
   vrrp 20 ip 10.20.20.1
   vrrp 20 priority 120
   vrrp 20 preempt
   no shutdown
!
interface Vlan30
   description guest-10.30.30.0/24
   ip address 10.30.30.3/24
   vrrp 30 ip 10.30.30.1
   vrrp 30 priority 100
   vrrp 30 preempt
   no shutdown
!
interface Vlan99
   description mgmt-192.168.99.0/24
   ip address 192.168.99.3/24
   vrrp 99 ip 192.168.99.1
   vrrp 99 priority 100
   vrrp 99 preempt
   no shutdown
!
router ospf 1
   router-id 10.0.0.5
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet2
   ! Loopback and uplinks in area 0 — makes dist2 an ABR (area 0 + area 1)
   network 10.0.0.5/32 area 0.0.0.0
   network 10.0.14.0/30 area 0.0.0.0
   network 10.0.24.0/30 area 0.0.0.0
   ! VLAN subnets in area 1 — inter-area (OI) routes on core/edge
   network 10.10.10.0/24 area 0.0.0.1
   network 10.20.20.0/24 area 0.0.0.1
   network 10.30.30.0/24 area 0.0.0.1
   network 192.168.99.0/24 area 0.0.0.1
!
end
