! core1  (Arista EOS)
!
! Core layer — OSPF area 0 backbone router.
! Connects to: edge (uplink), core2 (peer link), dist1 and dist2 (downlinks).
! Loopback: 10.0.0.2/32
!
hostname core1
!
ip routing
!
interface Loopback0
   description router-id
   ip address 10.0.0.2/32
!
interface Ethernet1
   description to-edge  10.255.1.0/30
   no switchport
   ip address 10.255.1.2/30
   no shutdown
!
interface Ethernet2
   description to-core2  10.255.3.0/30
   no switchport
   ip address 10.255.3.1/30
   no shutdown
!
interface Ethernet3
   description to-dist1  10.0.13.0/30
   no switchport
   ip address 10.0.13.1/30
   no shutdown
!
interface Ethernet4
   description to-dist2  10.0.14.0/30
   no switchport
   ip address 10.0.14.1/30
   no shutdown
!
router ospf 1
   router-id 10.0.0.2
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet2
   no passive-interface Ethernet3
   no passive-interface Ethernet4
   network 10.0.0.2/32 area 0.0.0.0
   network 10.255.1.0/30 area 0.0.0.0
   network 10.255.3.0/30 area 0.0.0.0
   network 10.0.13.0/30 area 0.0.0.0
   network 10.0.14.0/30 area 0.0.0.0
!
end
