hostname sw1
!
no ip routing
!
spanning-tree mode rstp
!
! Learner tasks:
!  - create VLAN 10 and VLAN 20
!  - make Ethernet1 an access port for VLAN 10
!  - make Ethernet2 an access port for VLAN 20
!  - make Ethernet3 a trunk carrying VLANs 10 and 20
!
interface Ethernet1
   description to-host-a users
   no shutdown
!
interface Ethernet2
   description to-voice-a voice
   no shutdown
!
interface Ethernet3
   description to-sw2 trunk
   no shutdown
!
end
