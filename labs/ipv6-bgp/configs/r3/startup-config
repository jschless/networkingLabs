hostname r3
!
ip routing
ipv6 unicast-routing
!
interface Loopback0
   ip address 10.0.0.3/32
   ipv6 address 2001:db8::3/128
!
interface Ethernet1
   description to r2 (AS65002) — iBGP
   no switchport
   ip address 10.1.23.2/30
   ipv6 address 2001:db8:23::2/64
!
interface Ethernet2
   description to r4 (AS65003) — eBGP
   no switchport
   ip address 10.1.34.1/30
   ipv6 address 2001:db8:34::1/64
!
! ── Task: Configure iBGP to r2 and eBGP to r4, dual-stack ───────────────────
! r3 is in AS65002. Peers: r2 at 10.1.23.1/2001:db8:23::1 (iBGP),
!   r4 at 10.1.34.2/2001:db8:34::2 (eBGP).
! KEY: next-hop-self for iBGP peer r2 in both AFs (so r2 can reach r4's next-hop).
!
! router bgp 65002
!    bgp router-id 10.0.0.3
!    neighbor 10.1.23.1 remote-as 65002
!    neighbor 10.1.34.2 remote-as 65003
!    neighbor 2001:db8:23::1 remote-as 65002
!    neighbor 2001:db8:34::2 remote-as 65003
!    !
!    address-family ipv4
!       neighbor 10.1.23.1 activate
!       neighbor 10.1.34.2 activate
!       neighbor 10.1.34.2 next-hop-self
!       network 10.0.0.3/32
!    !
!    address-family ipv6
!       neighbor 2001:db8:23::1 activate
!       neighbor 2001:db8:34::2 activate
!       neighbor 2001:db8:34::2 next-hop-self
!       network 2001:db8::3/128
!    !
! !
end
