hostname r1
!
ip routing
ipv6 unicast-routing
!
interface Loopback0
   ip address 10.0.0.1/32
   ipv6 address 2001:db8::1/128
!
interface Ethernet1
   description to r2 (AS65002)
   no switchport
   ip address 10.1.12.1/30
   ipv6 address 2001:db8:12::1/64
!
! ── Task: Configure dual-stack BGP to r2 ─────────────────────────────────────
! r1 is in AS65001. r2 is in AS65002.
!
! APPROACH A — Separate sessions (one IPv4, one IPv6):
!
! router bgp 65001
!    bgp router-id 10.0.0.1
!    ! IPv4 session
!    neighbor 10.1.12.2 remote-as 65002
!    ! IPv6 session
!    neighbor 2001:db8:12::2 remote-as 65002
!    !
!    address-family ipv4
!       neighbor 10.1.12.2 activate
!       network 10.0.0.1/32
!    !
!    address-family ipv6
!       neighbor 2001:db8:12::2 activate
!       network 2001:db8::1/128
!    !
! !
!
! APPROACH B — Single IPv4 session with extended-nexthop for IPv6:
! (Requires neighbor to support BGP extended-nexthop capability)
!
! router bgp 65001
!    bgp router-id 10.0.0.1
!    neighbor 10.1.12.2 remote-as 65002
!    !
!    address-family ipv4
!       neighbor 10.1.12.2 activate
!       network 10.0.0.1/32
!    !
!    address-family ipv6
!       neighbor 10.1.12.2 activate
!       neighbor 10.1.12.2 next-hop unchanged
!       network 2001:db8::1/128
!    !
! !
end
