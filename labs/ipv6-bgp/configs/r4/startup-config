hostname r4
!
ip routing
ipv6 unicast-routing
!
interface Loopback0
   ip address 10.0.0.4/32
   ipv6 address 2001:db8::4/128
!
interface Ethernet1
   description to r3 (AS65002) — eBGP
   no switchport
   ip address 10.1.34.2/30
   ipv6 address 2001:db8:34::2/64
!
! ── Task: Configure dual-stack eBGP to r3 ────────────────────────────────────
! r4 is in AS65003. Single eBGP peer: r3 at 10.1.34.1/2001:db8:34::1.
!
! router bgp 65003
!    bgp router-id 10.0.0.4
!    neighbor 10.1.34.1 remote-as 65002
!    neighbor 2001:db8:34::1 remote-as 65002
!    !
!    address-family ipv4
!       neighbor 10.1.34.1 activate
!       network 10.0.0.4/32
!    !
!    address-family ipv6
!       neighbor 2001:db8:34::1 activate
!       network 2001:db8::4/128
!    !
! !
end
