hostname r2
!
ip routing
ipv6 unicast-routing
!
interface Loopback0
   ip address 10.0.0.2/32
   ipv6 address 2001:db8::2/128
!
interface Ethernet1
   description to r1 (AS65001) — eBGP
   no switchport
   ip address 10.1.12.2/30
   ipv6 address 2001:db8:12::2/64
!
interface Ethernet2
   description to r3 (AS65002) — iBGP
   no switchport
   ip address 10.1.23.1/30
   ipv6 address 2001:db8:23::1/64
!
! ── Task: Configure eBGP to r1 and iBGP to r3, dual-stack ───────────────────
! r2 is in AS65002. Peers: r1 at 10.1.12.1/2001:db8:12::1 (eBGP),
!   r3 at 10.1.23.2/2001:db8:23::2 (iBGP).
! KEY: next-hop-self needed for iBGP peer r3 (both IPv4 and IPv6 AFs).
!
! router bgp 65002
!    bgp router-id 10.0.0.2
!    neighbor 10.1.12.1 remote-as 65001
!    neighbor 10.1.23.2 remote-as 65002
!    neighbor 2001:db8:12::1 remote-as 65001
!    neighbor 2001:db8:23::2 remote-as 65002
!    !
!    address-family ipv4
!       neighbor 10.1.12.1 activate
!       neighbor 10.1.23.2 activate
!       neighbor 10.1.23.2 next-hop-self
!       network 10.0.0.2/32
!    !
!    address-family ipv6
!       neighbor 2001:db8:12::1 activate
!       neighbor 2001:db8:23::2 activate
!       neighbor 2001:db8:23::2 next-hop-self
!       network 2001:db8::2/128
!    !
! !
end
