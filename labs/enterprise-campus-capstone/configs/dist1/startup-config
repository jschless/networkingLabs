! dist1  (Arista EOS)
!
! Distribution layer — OSPF ABR (area 0 + area 1), VRRP gateway, STP root.
! Loopback: 10.0.0.4/32
!
! VRRP roles (to configure):
!   VLAN 10 (corporate): ACTIVE  — priority 120 (wins over dist2)
!   VLAN 20 (voice):     BACKUP  — priority 100 (dist2 wins)
!   VLAN 30 (guest):     ACTIVE  — priority 120 (wins over dist2)
!   VLAN 99 (mgmt):      ACTIVE  — priority 120
!
! STP roles (to configure):
!   VLAN 10, 30, 99: PRIMARY root   — priority 4096
!   VLAN 20:         SECONDARY root — priority 8192
!
hostname dist1
!
ip routing
!
spanning-tree mode rstp
!
vlan 10,20,30,99
!
interface Loopback0
   description router-id
   ip address 10.0.0.4/32
!
! Routed uplinks to core (no switchport)
interface Ethernet1
   description to-core1  10.0.13.0/30
   no switchport
   ip address 10.0.13.2/30
   no shutdown
!
interface Ethernet2
   description to-core2  10.0.23.0/30
   no switchport
   ip address 10.0.23.2/30
   no shutdown
!
! Trunk downlinks to access switches (L2 — no "no switchport")
interface Ethernet3
   description to-acc1  trunk
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
interface Ethernet4
   description to-acc2  trunk
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
! VLAN SVIs — IPs pre-configured; add VRRP under each SVI
interface Vlan10
   description corporate-10.10.10.0/24
   ip address 10.10.10.2/24
   no shutdown
!
interface Vlan20
   description voice-10.20.20.0/24
   ip address 10.20.20.2/24
   no shutdown
!
interface Vlan30
   description guest-10.30.30.0/24
   ip address 10.30.30.2/24
   no shutdown
!
interface Vlan99
   description mgmt-192.168.99.0/24
   ip address 192.168.99.2/24
   no shutdown
!
! ================================================
! dist1  —  Capstone Tasks
!
! Role: Distribution ABR — OSPF area 0 uplinks, area 1 SVIs, VRRP active for VLAN 10/30/99
!
! Task 1 — STP Root Bridge Priorities
!   Make dist1 the primary root for VLANs 10, 30, 99 and secondary for VLAN 20.
!   Hint:
!     spanning-tree vlan-id 10 priority 4096
!     spanning-tree vlan-id 30 priority 4096
!     spanning-tree vlan-id 99 priority 4096
!     spanning-tree vlan-id 20 priority 8192
!
! Task 2 — VRRP on all SVIs
!   Configure VRRP group per VLAN. dist1 is ACTIVE (120) for VLANs 10/30/99
!   and BACKUP (100) for VLAN 20. VIP is x.x.x.1 on each subnet.
!   Hint:
!     interface Vlan10
!        vrrp 10 ip 10.10.10.1
!        vrrp 10 priority 120
!        vrrp 10 preempt
!     interface Vlan20
!        vrrp 20 ip 10.20.20.1
!        vrrp 20 priority 100
!        vrrp 20 preempt
!     interface Vlan30
!        vrrp 30 ip 10.30.30.1
!        vrrp 30 priority 120
!        vrrp 30 preempt
!     interface Vlan99
!        vrrp 99 ip 192.168.99.1
!        vrrp 99 priority 120
!        vrrp 99 preempt
!
! Task 3 — OSPF ABR
!   Configure OSPF process 1 with Ethernet1/2 active (uplinks to core, area 0).
!   Loopback + uplinks go in area 0; VLAN SVIs go in area 1. dist1 becomes an ABR.
!   Hint:
!     router ospf 1
!        router-id 10.0.0.4
!        passive-interface default
!        no passive-interface Ethernet1
!        no passive-interface Ethernet2
!        network 10.0.0.4/32 area 0.0.0.0
!        network 10.0.13.0/30 area 0.0.0.0
!        network 10.0.23.0/30 area 0.0.0.0
!        network 10.10.10.0/24 area 0.0.0.1
!        network 10.20.20.0/24 area 0.0.0.1
!        network 10.30.30.0/24 area 0.0.0.1
!        network 192.168.99.0/24 area 0.0.0.1
! ================================================
!
end
