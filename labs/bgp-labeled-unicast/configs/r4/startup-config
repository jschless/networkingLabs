hostname r4
!
ip routing
!
mpls ip
!
interface Loopback0
   ip address 10.0.0.4/32
!
interface Ethernet1
   description to r3 (AS65002 — iBGP-LU)
   no switchport
   ip address 10.1.34.2/30
   mpls ip
!
! ── IGP: OSPF within AS65002 (pre-configured) ────────────────────────────────
router ospf 1
   router-id 10.0.0.4
   passive-interface Loopback0
   network 10.0.0.4/32 area 0.0.0.0
   network 10.1.34.0/30 area 0.0.0.0
!
! ── Task: Configure iBGP-LU to r3 ────────────────────────────────────────────
! r4 is in AS65002. Single iBGP-LU peer: r3 at 10.0.0.3 (loopback via OSPF).
!
! router bgp 65002
!    bgp router-id 10.0.0.4
!    neighbor 10.0.0.3 remote-as 65002
!    neighbor 10.0.0.3 update-source Loopback0
!    !
!    address-family ipv4 labeled-unicast
!       neighbor 10.0.0.3 activate
!       network 10.0.0.4/32
!    !
! !
end
