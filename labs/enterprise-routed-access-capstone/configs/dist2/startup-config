! dist2 — Arista EOS
! Distribution switch, OSPF ABR (area 0 uplinks, area 1 downlink + stub)
! Loopback: 10.0.1.2/32
! Uplinks: core1 (10.1.0.2/31), core2 (10.1.1.2/31) — area 0
! Downlink: acc1 (10.2.0.2/31) — area 1 stub
!
hostname dist2
!
ip routing
!
interface Loopback0
   description router-id
   ip address 10.0.1.2/32
!
interface Ethernet1
   description to-core1
   no switchport
   ip address 10.1.0.3/31
   no shutdown
!
interface Ethernet2
   description to-core2
   no switchport
   ip address 10.1.1.3/31
   no shutdown
!
interface Ethernet3
   description to-acc1
   no switchport
   ip address 10.2.0.2/31
   no shutdown
!
! ================================================
! dist2  —  Capstone Tasks
!
! Role: ABR bridging area 0 (uplinks to core) and area 1 stub (downlink to acc1)
!
! Task 1 — OSPF ABR with stub area 1
!   Same structure as dist1 — area 0 uplinks, area 1 stub downlink, BFD.
!   Hint:
!     router ospf 1
!        router-id 10.0.1.2
!        passive-interface default
!        no passive-interface Ethernet1
!        no passive-interface Ethernet2
!        no passive-interface Ethernet3
!        bfd default
!        max-lsa 12000
!        network 10.0.1.2/32 area 0.0.0.0
!        network 10.1.0.2/31 area 0.0.0.0
!        network 10.1.1.2/31 area 0.0.0.0
!        network 10.2.0.2/31 area 0.0.0.1
!        area 0.0.0.1 stub
! ================================================
!
end
