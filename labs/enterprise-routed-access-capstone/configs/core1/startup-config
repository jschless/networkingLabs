! core1 — Arista EOS
! Core switch, OSPF area 0 + BFD
! Loopback: 10.0.0.1/32
! iBGP peer: core2 (10.0.0.2)
!
hostname core1
!
ip routing
!
interface Loopback0
   description router-id
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to-dist1
   no switchport
   ip address 10.1.0.0/31
   no shutdown
!
interface Ethernet2
   description to-dist2
   no switchport
   ip address 10.1.0.2/31
   no shutdown
!
interface Ethernet3
   description to-dist3
   no switchport
   ip address 10.1.0.4/31
   no shutdown
!
interface Ethernet4
   description to-dist4
   no switchport
   ip address 10.1.0.6/31
   no shutdown
!
interface Ethernet5
   description to-core2
   no switchport
   ip address 10.1.2.0/31
   no shutdown
!
! ================================================
! core1  —  Capstone Tasks
!
! Role: Core area 0 router with BFD and iBGP
!
! Task 1 — OSPF Area 0 with BFD
!   All 5 Ethernet interfaces active. Enable BFD globally under OSPF
!   so all OSPF neighbors get sub-second failure detection.
!   Hint:
!     router ospf 1
!        router-id 10.0.0.1
!        passive-interface default
!        no passive-interface Ethernet1
!        no passive-interface Ethernet2
!        no passive-interface Ethernet3
!        no passive-interface Ethernet4
!        no passive-interface Ethernet5
!        bfd default
!        max-lsa 12000
!        network 10.0.0.1/32 area 0.0.0.0
!        network 10.1.0.0/31 area 0.0.0.0
!        network 10.1.0.2/31 area 0.0.0.0
!        network 10.1.0.4/31 area 0.0.0.0
!        network 10.1.0.6/31 area 0.0.0.0
!        network 10.1.2.0/31 area 0.0.0.0
!
! Task 2 — iBGP stub peer with core2
!   Configure iBGP AS 65000 peering with core2 (10.0.0.2) using
!   Loopback0 as update-source. This provides a foundation for future
!   L3VPN or internet exit extensions.
!   Hint:
!     router bgp 65000
!        router-id 10.0.0.1
!        neighbor 10.0.0.2 remote-as 65000
!        neighbor 10.0.0.2 update-source Loopback0
!        neighbor 10.0.0.2 description core2
!        address-family ipv4
!           neighbor 10.0.0.2 activate
! ================================================
!
end
