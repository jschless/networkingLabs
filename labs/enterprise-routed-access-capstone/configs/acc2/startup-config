hostname acc2
!
ip routing
!
interface Loopback0
   description router-id
   ip address 10.0.2.2/32
!
interface Ethernet1
   description to-dist3
   no switchport
   ip address 10.2.1.1/31
   no shutdown
!
interface Ethernet2
   description to-dist4
   no switchport
   ip address 10.2.1.3/31
   no shutdown
!
interface Ethernet3
   description to-h3
   no switchport
   ip address 10.10.2.1/30
   no shutdown
!
interface Ethernet4
   description to-h4
   no switchport
   ip address 10.10.2.5/30
   no shutdown
!
