! spine2 — AS65200  (Arista EOS)
!
! Spines are fully pre-configured.
! Mirrors spine1 — same role, different AS, connects to leaf eth2 uplinks.
!
hostname spine2
!
interface Loopback0
   ip address 10.0.0.102/32
!
interface Ethernet1
   description to leaf1  10.2.0.0/31
   no switchport
   ip address 10.2.0.1/31
   no shutdown
!
interface Ethernet2
   description to leaf2  10.2.0.2/31
   no switchport
   ip address 10.2.0.3/31
   no shutdown
!
interface Ethernet3
   description to leaf3  10.2.0.4/31
   no switchport
   ip address 10.2.0.5/31
   no shutdown
!
interface Ethernet4
   description to leaf4  10.2.0.6/31
   no switchport
   ip address 10.2.0.7/31
   no shutdown
!
interface Ethernet5
   description to bleaf1  10.2.0.8/31
   no switchport
   ip address 10.2.0.9/31
   no shutdown
!
ip routing
!
router bgp 65200
   router-id 10.0.0.102
   maximum-paths 4 ecmp 4
   bgp bestpath as-path multipath-relax
   !
   neighbor 10.2.0.0 remote-as 65001
   neighbor 10.2.0.0 send-community extended
   neighbor 10.2.0.2 remote-as 65002
   neighbor 10.2.0.2 send-community extended
   neighbor 10.2.0.4 remote-as 65003
   neighbor 10.2.0.4 send-community extended
   neighbor 10.2.0.6 remote-as 65004
   neighbor 10.2.0.6 send-community extended
   neighbor 10.2.0.8 remote-as 65005
   neighbor 10.2.0.8 send-community extended
   !
   address-family ipv4
      neighbor 10.2.0.0 activate
      neighbor 10.2.0.2 activate
      neighbor 10.2.0.4 activate
      neighbor 10.2.0.6 activate
      neighbor 10.2.0.8 activate
      network 10.0.0.102/32
   !
   address-family evpn
      neighbor 10.2.0.0 activate
      neighbor 10.2.0.2 activate
      neighbor 10.2.0.4 activate
      neighbor 10.2.0.6 activate
      neighbor 10.2.0.8 activate
      neighbor 10.2.0.0 next-hop-unchanged
      neighbor 10.2.0.2 next-hop-unchanged
      neighbor 10.2.0.4 next-hop-unchanged
      neighbor 10.2.0.6 next-hop-unchanged
      neighbor 10.2.0.8 next-hop-unchanged
!
end
