! host-a1 — Tenant-A server  (Arista EOS acting as end host)
! IP: 10.10.10.11/24,  gateway: 10.10.10.1 (anycast IRB on leaf1)
! Connected to: leaf1 Ethernet3 (access VLAN 10)
!
hostname host-a1
!
interface Ethernet1
   description to leaf1 (VLAN 10, Tenant-A)
   no switchport
   ip address 10.10.10.11/24
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 10.10.10.1
!
end
