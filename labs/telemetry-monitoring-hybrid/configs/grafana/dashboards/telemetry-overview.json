      "id": 1,
      "options": {
        "content": "<h2>Telemetry Overview</h2><p>This dashboard is your quick operational summary. It compares the two telemetry-capable nodes, shows whether Prometheus is scraping the collector, and answers a simple question first: do I have live metrics from the devices I expect?</p>",
        "mode": "html"
      },
      "pluginVersion": "11.2.0",
      "title": "How To Use This Dashboard",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafana"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 2,
      "options": {
