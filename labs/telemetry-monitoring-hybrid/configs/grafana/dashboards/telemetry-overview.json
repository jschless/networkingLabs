          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (target) (rate(interfaces_interface_state_counters_in_octets{target=~\"campus1|core1\",interface_name=~\"Ethernet.*\"}[1m])) * 8",
          "legendFormat": "{{target}}",
          "range": true,
          "refId": "A"
