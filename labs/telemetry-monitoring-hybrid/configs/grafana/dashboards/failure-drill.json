      "options": {
        "content": "<h2>Failure Drill</h2><p>Run <code>scripts/link-down-campus-pe.sh</code> and then <code>scripts/link-up-campus-pe.sh</code>. This is the fast symptom dashboard. Use it to confirm what changed immediately, then switch to OpenNMS for events, outages, and interface state.</p>",
        "mode": "html"
      },
      "pluginVersion": "11.2.0",
      "title": "How To Use This Dashboard",
      "type": "text"
    },
    {
