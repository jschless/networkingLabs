      "id": 1,
      "options": {
        "content": "<h2>Traffic Investigation</h2><p>Run <code>scripts/traffic-start.sh 30</code>, then compare edge and core behavior. This is where you practice moving from an operator question like \"Where is the traffic?\" to a Prometheus query and a dashboard panel.</p>",
        "mode": "html"
      },
      "pluginVersion": "11.2.0",
      "title": "How To Use This Dashboard",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafana"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(interfaces_interface_state_counters_in_octets{target=\"campus1\",interface_name=~\"Ethernet.*\"}[1m]) * 8",
          "legendFormat": "{{interface_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Campus1 Per-Interface Ingress",
