      "id": 1,
      "options": {
        "content": "<h2>Traffic Investigation</h2><p>Use this view while running <code>scripts/traffic-start.sh</code>. Start with the total throughput panels, then drill into Ethernet1 and Ethernet2 to see where the path is carrying traffic.</p><p>Questions to answer: which interface is moving, how fast is it moving, and does the path behavior match the traffic you generated?</p>",
        "mode": "html"
      },
      "pluginVersion": "11.2.0",
      "title": "How To Use This Dashboard",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafana"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
