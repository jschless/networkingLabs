hostname r2
!
! -------------------------------------------------------
! Node: r2  (Control Plane Policing — DUT)
!
! Pre-configured: IP addressing, BGP to r1, OSPF to r3
!
! Your tasks:
!   1. Define ACLs to classify traffic types destined to the control plane
!   2. Create class-map type copp for each traffic class
!   3. Build a policy-map type copp with police rates per class
!   4. Apply the policy to the control-plane with service-policy input
!   5. Verify counters increment as traffic hits each class
!
! Hints — ACLs:
!   ip access-list CoPP-BGP
!      permit tcp any any eq bgp
!      permit tcp any eq bgp any
!   !
!   ip access-list CoPP-OSPF
!      permit ospf any any
!   !
!   ip access-list CoPP-ICMP
!      permit icmp any any
!   !
!   ip access-list CoPP-SSH
!      permit tcp any any eq 22
!   !
!   ip access-list CoPP-ARP
!      permit arp any any
!
! Hints — class-maps:
!   class-map type copp match-any CLASS-BGP
!      match ip access-group CoPP-BGP
!   !
!   class-map type copp match-any CLASS-OSPF
!      match ip access-group CoPP-OSPF
!   !
!   class-map type copp match-any CLASS-ICMP
!      match ip access-group CoPP-ICMP
!   !
!   class-map type copp match-any CLASS-SSH
!      match ip access-group CoPP-SSH
!   !
!   class-map type copp match-any CLASS-ARP
!      match arp access-group CoPP-ARP
!
! Hints — policy-map:
!   policy-map type copp COPP-POLICY
!      class CLASS-BGP
!         police rate 1 mbps burst-size 64 kb
!      !
!      class CLASS-OSPF
!         police rate 512 kbps burst-size 32 kb
!      !
!      class CLASS-ICMP
!         police rate 100 kbps burst-size 8 kb
!      !
!      class CLASS-SSH
!         police rate 1 mbps burst-size 64 kb
!      !
!      class CLASS-ARP
!         police rate 256 kbps burst-size 16 kb
!      !
!      class class-default
!         police rate 64 kbps burst-size 8 kb
!
! Hints — apply:
!   control-plane
!      service-policy input COPP-POLICY
!
! -------------------------------------------------------
!
no aaa root
!
ip routing
!
interface Loopback0
 ip address 10.0.0.2/32
!
interface Ethernet1
 no switchport
 description to r1 (eBGP AS65001)
 ip address 10.1.12.2/30
!
interface Ethernet2
 no switchport
 description to r3 (OSPF area 0)
 ip address 10.1.23.1/30
!
router ospf 1
 router-id 10.0.0.2
 passive-interface Loopback0
!
interface Ethernet2
 ip ospf area 0
!
interface Loopback0
 ip ospf area 0
 ip ospf passive
!
router bgp 65002
 router-id 10.0.0.2
 neighbor 10.1.12.1 remote-as 65001
 !
 address-family ipv4
  neighbor 10.1.12.1 activate
  network 10.0.0.2/32
  network 10.1.12.0/30
