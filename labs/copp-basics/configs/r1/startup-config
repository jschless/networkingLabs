hostname r1
!
no aaa root
!
ip routing
!
interface Loopback0
 ip address 10.0.0.1/32
!
interface Ethernet1
 no switchport
 description to r2 (eBGP AS65002)
 ip address 10.1.12.1/30
!
router bgp 65001
 router-id 10.0.0.1
 neighbor 10.1.12.2 remote-as 65002
 !
 address-family ipv4
  neighbor 10.1.12.2 activate
  network 10.0.0.1/32
  network 10.1.12.0/30
