hostname hub
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description WAN NBMA network
   no switchport
   ip address 10.0.0.1/24
   no shutdown
!
interface Tunnel0
   description DMVPN mGRE hub
   tunnel source Ethernet1
   tunnel mode gre multipoint
   ip address 172.16.0.1/24
   ip nhrp network-id 1
   ip nhrp holdtime 300
   ip nhrp redirect
   ip ospf network point-to-multipoint
   ip ospf area 0
   no shutdown
!
ip routing
!
router ospf 1
   router-id 10.0.0.1
   passive-interface Loopback0
!
end
