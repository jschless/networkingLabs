hostname r1
!
no aaa root
!
username admin privilege 15 role network-admin secret admin
!
ip routing
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   no switchport
   description to r2
   ip address 10.1.12.1/30
!
router ospf 1
   router-id 10.0.0.1
   passive-interface Loopback0
   network 0.0.0.0/0 area 0.0.0.0
!
