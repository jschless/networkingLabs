hostname router
!
interface Ethernet1
 ! Primary uplink to isp1: 10.0.1.0/30, router=.1
 ip address 10.0.1.1/30
!
interface Ethernet2
 ! Backup uplink to isp2: 10.0.2.0/30, router=.1
 ip address 10.0.2.1/30
!
! TODO: Step 1 - Two floating static routes
!
