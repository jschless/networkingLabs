hostname isp2
!
ip routing
!
interface Loopback0
   ip address 10.0.0.3/32
!
interface Ethernet1
   description to ce1 (AS65001)
   no switchport
   ip address 10.1.12.2/30
!
interface Ethernet2
   description to isp1 — iBGP peering
   no switchport
   ip address 10.1.99.2/30
!
interface Ethernet3
   description to ce2 (AS65002)
   no switchport
   ip address 10.1.22.1/30
!
router bgp 65100
   bgp router-id 10.0.0.3
   neighbor 10.1.12.1 remote-as 65001
   neighbor 10.1.99.1 remote-as 65100
   neighbor 10.1.22.2 remote-as 65002
   !
   address-family ipv4
      neighbor 10.1.12.1 activate
      neighbor 10.1.99.1 activate
      neighbor 10.1.99.1 next-hop-self
      neighbor 10.1.22.2 activate
      network 10.0.0.3/32
   !
!
end
