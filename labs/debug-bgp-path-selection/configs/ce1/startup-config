hostname ce1
!
ip routing
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to isp1 (AS65100)
   no switchport
   ip address 10.1.11.1/30
!
interface Ethernet2
   description to isp2 (AS65100)
   no switchport
   ip address 10.1.12.1/30
!
router bgp 65001
   bgp router-id 10.0.0.1
   neighbor 10.1.11.2 remote-as 65100
   neighbor 10.1.12.2 remote-as 65100
   !
   address-family ipv4
      neighbor 10.1.11.2 activate
      neighbor 10.1.12.2 activate
      network 10.0.0.1/32
   !
!
end
