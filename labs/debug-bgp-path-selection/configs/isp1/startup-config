hostname isp1
!
ip routing
!
interface Loopback0
   ip address 10.0.0.2/32
!
interface Ethernet1
   description to ce1 (AS65001)
   no switchport
   ip address 10.1.11.2/30
!
interface Ethernet2
   description to isp2 — iBGP peering
   no switchport
   ip address 10.1.99.1/30
!
interface Ethernet3
   description to ce2 (AS65002)
   no switchport
   ip address 10.1.21.1/30
!
route-map LP-CE1-HIGH permit 10
   set local-preference 200
!
router bgp 65100
   bgp router-id 10.0.0.2
   neighbor 10.1.11.1 remote-as 65001
   neighbor 10.1.99.2 remote-as 65100
   neighbor 10.1.21.2 remote-as 65002
   !
   address-family ipv4
      neighbor 10.1.11.1 activate
      neighbor 10.1.11.1 route-map LP-CE1-HIGH out
      neighbor 10.1.99.2 activate
      neighbor 10.1.99.2 next-hop-self
      neighbor 10.1.21.2 activate
      network 10.0.0.2/32
   !
!
end
