! acc3 — access layer switch #3  (Arista EOS)
!
! Pure L2 switch. No ip routing.
! Uplink to cc2 (trunk). Downlink to client-b (VLAN 20 access).
!
! STP: non-root on all VLANs (default priority 32768).
! PortFast enabled on access port to client-b for fast port transitions.
!
hostname acc3
!
spanning-tree mode rstp
!
vlan 10
   name corporate
!
vlan 20
   name voice
!
vlan 30
   name guest
!
vlan 99
   name management
!
interface Ethernet1
   description to-cc2-trunk
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
interface Ethernet2
   description to-client-b  access-vlan20
   switchport access vlan 20
   switchport mode access
   spanning-tree portfast
   no shutdown
!
end
