hostname asbr
!
ip routing
!
! ============================================================
! asbr — edge router connecting the OSPF domain to the internet
!
! Topology: [core] --OSPF area 0-- [asbr] --NOT in OSPF-- [internet]
!
! asbr has two roles:
!   1. OSPF router in area 0 (internal side, Ethernet1)
!   2. Static default route toward internet (external side, Ethernet2)
!
! asbr will inject the default route into OSPF using:
!   default-information originate
!
! This generates a Type-5 External LSA for 0.0.0.0/0 which core
! learns as an O*E2 route.
! ============================================================

interface Loopback0
 ip address 10.0.0.2/32

! Link to core — segment 10.1.12.0/30 — OSPF area 0
! core is .1, asbr is .2
interface Ethernet1
 no switchport
 description Link to core (10.1.12.0/30, core=.1 asbr=.2) — OSPF area 0
 ip address 10.1.12.2/30

! Link to internet — segment 203.0.113.0/30 — NOT in OSPF
! asbr is .1, internet is .2
interface Ethernet2
 no switchport
 description Link to internet (203.0.113.0/30, asbr=.1 internet=.2) — external, NOT in OSPF
 ip address 203.0.113.1/30

! ============================================================
! TODO: Configure OSPF and default route injection
!
! Step 1 — Basic OSPF (internal side only — do NOT put Ethernet2 in OSPF):
!   router ospf 1
!    ospf router-id 10.0.0.2
!    network 10.0.0.2/32 area 0
!    network 10.1.12.0/30 area 0
!    passive-interface Loopback0
!    ! Do NOT include 203.0.113.0/30 — that is the external side
!
! Step 2 — Add static default route toward internet:
!   ip route 0.0.0.0/0 203.0.113.2
!   Verify it is installed: show ip route static
!
! Step 3 — Inject the default into OSPF:
!   router ospf 1
!    default-information originate
!
!   This generates a Type-5 LSA for 0.0.0.0/0 ONLY if 0.0.0.0/0 exists
!   in the routing table. If you remove the static default, the OSPF
!   advertisement stops automatically.
!
! Step 4 — Experiment: remove the static default
!   no ip route 0.0.0.0/0 203.0.113.2
!   Watch core lose its O*E2 default route.
!   Re-add: ip route 0.0.0.0/0 203.0.113.2
!
! Step 5 — The `always` keyword:
!   router ospf 1
!    default-information originate always
!   Now the default is advertised even with no static default present.
!   Useful when asbr learns its default via BGP or another protocol
!   that FRR might not track directly.
!
! Step 6 — Conditional default with route-map:
!   Only originate the default if 203.0.113.0/30 is reachable
!   (i.e., the internet link is up):
!
!   ip prefix-list INTERNET-REACHABLE seq 5 permit 203.0.113.0/30
!
!   route-map CHECK-INTERNET permit 10
!    match ip address prefix-list INTERNET-REACHABLE
!
!   router ospf 1
!    default-information originate always route-map CHECK-INTERNET
!
!   Now the default is injected only when 203.0.113.0/30 is present
!   in the routing table (i.e., Ethernet2 is up). Shut Ethernet2 down and watch
!   the default disappear from core:
!     ip link set Ethernet2 down    (in bash, not vtysh)
!
! Useful verification commands:
!   show ip route                    — check static default is present
!   show ip ospf database external   — verify Type-5 LSA for 0.0.0.0/0
!   show ip ospf database            — full LSDB
! ============================================================
