hostname r1
!
ip routing
ipv6 unicast-routing

interface Loopback0
 ! IPv4 loopback — used as OSPFv3 router-id (OSPFv3 still needs a 32-bit router-id)
 ip address 10.0.0.1/32
 ! IPv6 loopback — advertise into OSPFv3
 ipv6 address 2001:db8::1/128

interface Ethernet1
 no switchport
 ! Link to r2: 2001:db8:12::/64
 ipv6 address 2001:db8:12::1/64

! -------------------------------------------------------
! YOUR TASK: Configure OSPFv3
!
! OSPFv3 is interface-based (unlike OSPFv2's "network" statements).
! Enable OSPFv3 on each interface with: ipv6 ospf6 area 0
! Mark loopback as passive so it does not send hellos.
!
! On each interface:
!   interface Ethernet1
!    ipv6 ospf6 area 0
!   interface Loopback0
!    ipv6 ospf6 area 0
!    ipv6 ospf6 passive
!
! Then create the OSPFv3 process and set a router-id:
!   router ospf6
!    ospf6 router-id 10.0.0.1
!
! Verify:
!   show ipv6 ospf6 neighbor
!   show ipv6 ospf6 database
!   show ipv6 route ospf6
! -------------------------------------------------------
