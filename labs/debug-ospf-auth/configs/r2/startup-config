hostname r2
!
ip routing
!
interface Loopback0
 ip address 10.0.0.2/32
!
interface Ethernet1
 no switchport
 description to r1
 ip address 10.1.12.2/30
 ip ospf authentication message-digest
 ip ospf message-digest-key 1 md5 SecretKey321
!
interface Ethernet2
 no switchport
 description to r3
