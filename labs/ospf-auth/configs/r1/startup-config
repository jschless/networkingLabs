hostname r1
!
ip routing
!
! ============================================================
! r1 — leftmost router in the linear chain: r1 --- r2 --- r3
! ============================================================

interface Loopback0
 ! Loopback: 10.0.0.1/32
 ! Hint: ip address 10.0.0.1/32
 ip address 10.0.0.1/32

! Link to r2 — segment 10.1.12.0/30
! r1 is .1, r2 is .2 on this segment
! Hint: ip address 10.1.12.1/30
interface Ethernet1
 no switchport
 description Link to r2 (10.1.12.0/30, r1=.1 r2=.2)
 ip address 10.1.12.1/30

