hostname leaf2
!
username admin privilege 15 role network-admin secret admin
!
ip routing
!
vrf instance BLUE
!
vrf instance GREEN
!
vlan 10
   name USERS
!
vlan 20
   name SERVERS
!
interface Loopback0
   ip address 10.255.0.14/32
!
interface Ethernet1
   description to spine1 Ethernet2
   no switchport
   ip address 10.0.0.3/31
   no shutdown
!
interface Ethernet2
   description to spine2 Ethernet2
   no switchport
   ip address 10.0.0.7/31
   no shutdown
!
interface Ethernet3
   description access port for VLAN 10
   switchport access vlan 10
   no shutdown
!
interface Ethernet4
   description access port for VLAN 20
   switchport access vlan 20
   no shutdown
!
interface Vlan10
   description BLUE users gateway
   vrf BLUE
   ip address 10.10.10.2/24
   no autostate
!
interface Vlan20
   description GREEN servers gateway
   vrf GREEN
   ip address 10.20.20.2/24
   no autostate
!
router bgp 65112
   router-id 10.255.0.14
   maximum-paths 2 ecmp 2
   neighbor 10.0.0.2 remote-as 65100
   neighbor 10.0.0.6 remote-as 65101
   !
   address-family ipv4
      neighbor 10.0.0.2 activate
      neighbor 10.0.0.6 activate
      network 10.255.0.14/32
   !
!
management api http-commands
   no shutdown
   protocol http
!
end
