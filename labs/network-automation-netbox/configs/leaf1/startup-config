hostname leaf1
!
username admin privilege 15 role network-admin secret admin
!
ip routing
!
vrf instance BLUE
!
vrf instance GREEN
!
vlan 10
   name USERS
!
vlan 20
   name SERVERS
!
interface Loopback0
   ip address 10.255.0.13/32
!
interface Ethernet1
   description to spine1 Ethernet1
   no switchport
   ip address 10.0.0.1/31
   no shutdown
!
interface Ethernet2
   description to spine2 Ethernet1
   no switchport
   ip address 10.0.0.5/31
   no shutdown
!
interface Ethernet3
   description access port for VLAN 10
   switchport access vlan 10
   no shutdown
!
interface Ethernet4
   description access port for VLAN 20
   switchport access vlan 20
   no shutdown
!
interface Vlan10
   description BLUE users gateway
   vrf BLUE
   ip address 10.10.10.1/24
   no autostate
!
interface Vlan20
   description GREEN servers gateway
   vrf GREEN
   ip address 10.20.20.1/24
   no autostate
!
router bgp 65111
   router-id 10.255.0.13
   maximum-paths 2 ecmp 2
   neighbor 10.0.0.0 remote-as 65100
   neighbor 10.0.0.4 remote-as 65101
   !
   address-family ipv4
      neighbor 10.0.0.0 activate
      neighbor 10.0.0.4 activate
      network 10.255.0.13/32
   !
!
management api http-commands
   no shutdown
   protocol http
!
end
