! cc1 — collapsed core switch #1  (Arista EOS)
!
! Dual-role L3 + L2, plus the integration glue for the grand capstone:
!   - VRRP active for VLAN 10 (corp) and VLAN 30 (guest); standby VLAN 20
!   - STP root for VLAN 10 and 30
!   - Ethernet5 = the lab-corp SERVICES SEAM (routed, in 10.100.0.0/16), with a
!     VRRP VIP 10.100.254.1 the service containers use as their return next-hop
!   - ip helper-address on each user SVI -> relays DHCP to Kea (dhcp1 10.100.30.10)
!   - SEAM-OUT ACL on Ethernet5: VLAN 30 guests are denied the internal services
!     but allowed the Internet (service-segmentation / "DMZ" policy). Enforced on
!     the physical seam port because cEOS does not enforce SVI-applied ACLs.
!
hostname cc1
!
spanning-tree mode rstp
spanning-tree vlan-id 10 priority 4096
spanning-tree vlan-id 30 priority 4096
spanning-tree vlan-id 20 priority 32768
spanning-tree vlan-id 99 priority 32768
!
vlan 10
   name corporate
!
vlan 20
   name voice
!
vlan 30
   name guest
!
vlan 99
   name management
!
ip routing
!
! Guest service-segmentation. Enforced as an EGRESS ACL on the physical seam
! port (Ethernet5) — cEOS's virtual dataplane does NOT enforce ACLs applied to
! SVIs, but DOES enforce them on physical routed ports. Everything leaving Et5
! is bound for the lab-corp services, so denying guest here = "guest can't reach
! internal services" while leaving its Internet path (out the edge) untouched.
ip access-list SEAM-OUT
   10 deny ip 10.30.30.0/24 any
   20 permit ip any any
!
interface Loopback0
   ip address 10.0.0.3/32
!
interface Ethernet1
   description to-edge  10.0.12.0/30
   no switchport
   ip address 10.0.12.2/30
   no shutdown
!
interface Ethernet2
   description to-cc2-interlink  10.0.99.0/30
   no switchport
   ip address 10.0.99.1/30
   no shutdown
!
interface Ethernet3
   description to-access-sw1-trunk
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
interface Ethernet4
   description cc-peer-link-trunk  (L2 path for VRRP adverts + inter-core client reachability)
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   no shutdown
!
interface Ethernet5
   description to-lab-corp-services-seam
   no switchport
   ip address 10.100.254.2/16
   ip access-group SEAM-OUT out
   vrrp 254 ipv4 10.100.254.1
   vrrp 254 priority-level 120
   vrrp 254 preempt
   no shutdown
!
interface Vlan10
   description corporate-gw
   ip address 10.10.10.2/24
   ip helper-address 10.100.30.10
   vrrp 10 ipv4 10.10.10.1
   vrrp 10 priority-level 120
   vrrp 10 preempt
   no shutdown
!
interface Vlan20
   description voice-gw
   ip address 10.20.20.2/24
   ip helper-address 10.100.30.10
   vrrp 20 ipv4 10.20.20.1
   vrrp 20 priority-level 100
   vrrp 20 preempt
   no shutdown
!
interface Vlan30
   description guest-gw
   ip address 10.30.30.2/24
   ip helper-address 10.100.30.10
   vrrp 30 ipv4 10.30.30.1
   vrrp 30 priority-level 120
   vrrp 30 preempt
   no shutdown
!
interface Vlan99
   description management-gw
   ip address 192.168.99.2/24
   vrrp 99 ipv4 192.168.99.1
   vrrp 99 priority-level 120
   vrrp 99 preempt
   no shutdown
!
router ospf 1
   router-id 10.0.0.3
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet2
   network 10.0.0.3/32 area 0.0.0.0
   network 10.0.12.0/30 area 0.0.0.0
   network 10.0.99.0/30 area 0.0.0.0
   network 10.10.10.0/24 area 0.0.0.0
   network 10.20.20.0/24 area 0.0.0.0
   network 10.30.30.0/24 area 0.0.0.0
   network 192.168.99.0/24 area 0.0.0.0
!
end
