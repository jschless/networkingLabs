hostname ce2
!
ip routing
!
interface Loopback0
   ip address 10.0.0.4/32
!
interface Ethernet1
   description to isp1 (AS65100)
   no switchport
   ip address 10.1.21.2/30
!
interface Ethernet2
   description to isp2 (AS65100)
   no switchport
   ip address 10.1.22.2/30
!
! ── Task: Configure dual-homed eBGP to isp1 and isp2 ───────────────────────
! ce2 is in AS65002. Peers: isp1 at 10.1.21.1, isp2 at 10.1.22.1.
!
! router bgp 65002
!    bgp router-id 10.0.0.4
!    neighbor 10.1.21.1 remote-as 65100
!    neighbor 10.1.22.1 remote-as 65100
!    !
!    address-family ipv4
!       neighbor 10.1.21.1 activate
!       neighbor 10.1.22.1 activate
!       network 10.0.0.4/32
!    !
! !
end
