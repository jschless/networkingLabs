hostname r1
!
username admin privilege 15 role network-admin secret admin
!
management api http-commands
   protocol http
   no shutdown
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description core-to-r2
   no switchport
   ip address 10.0.12.1/30
   no shutdown
!
interface Ethernet2
   description service-host-boundary
   no switchport
   ip address 10.0.101.1/30
   no shutdown
!
interface Ethernet3
   description site-1-clients
   no switchport
   ip address 172.16.1.1/24
   no shutdown
!
ip routing
!
router bgp 65001
   router-id 10.0.0.1
   neighbor 10.0.12.2 remote-as 65002
   network 10.0.0.1/32
   network 172.16.1.0/24
!
end
