hostname r1
!
ip routing
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to r2 (AS65002) — eBGP
   no switchport
   ip address 10.1.12.1/30
!
! ── Task: Configure eBGP to r2 ───────────────────────────────────────────────
! r1 is in AS65001. r2 is in AS65002 — eBGP peer at 10.1.12.2.
! Advertise the loopback 10.0.0.1/32 so r4 can reach it end-to-end.
!
! router bgp 65001
!    bgp router-id 10.0.0.1
!    neighbor 10.1.12.2 remote-as 65002
!    !
!    address-family ipv4
!       neighbor 10.1.12.2 activate
!       network 10.0.0.1/32
!    !
! !
end
