hostname r3
!
ip routing
!
interface Loopback0
   ip address 10.0.0.3/32
!
interface Ethernet1
   description to r2 (AS65002) — iBGP
   no switchport
   ip address 10.1.23.2/30
!
interface Ethernet2
   description to r4 (AS65003) — eBGP
   no switchport
   ip address 10.1.34.1/30
!
! ── Task: Configure iBGP to r2 and eBGP to r4 ───────────────────────────────
! r3 is in AS65002. Two peers:
!   r2 at 10.1.23.1 — iBGP (AS65002)
!   r4 at 10.1.34.2 — eBGP (AS65003)
!
! KEY CONCEPT: iBGP split-horizon
!   r3 will NOT re-advertise to r2 what it learned from r2 via iBGP.
!   This is the iBGP split-horizon rule. To propagate r4's prefix back to r2,
!   r4's prefix must be re-advertised via eBGP from r3, which works fine.
!   For r1's prefix to reach r4, r3 needs "neighbor 10.1.34.2 next-hop-self".
!
! router bgp 65002
!    bgp router-id 10.0.0.3
!    neighbor 10.1.23.1 remote-as 65002
!    neighbor 10.1.34.2 remote-as 65003
!    !
!    address-family ipv4
!       neighbor 10.1.23.1 activate
!       neighbor 10.1.34.2 activate
!       neighbor 10.1.34.2 next-hop-self
!       network 10.0.0.3/32
!    !
! !
end
