hostname r4
!
ip routing
!
interface Loopback0
   ip address 10.0.0.4/32
!
interface Ethernet1
   description to r3 (AS65002) — eBGP
   no switchport
   ip address 10.1.34.2/30
!
! ── Task: Configure eBGP to r3 ───────────────────────────────────────────────
! r4 is in AS65003. Peer with r3 at 10.1.34.1 (AS65002).
! Advertise 10.0.0.4/32. Goal: r1 and r4 can ping each other's loopbacks.
!
! router bgp 65003
!    bgp router-id 10.0.0.4
!    neighbor 10.1.34.1 remote-as 65002
!    !
!    address-family ipv4
!       neighbor 10.1.34.1 activate
!       network 10.0.0.4/32
!    !
! !
end
