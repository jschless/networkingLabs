! edge1 — WAN edge 1
! Base interfaces only. Configure OSPF/BFD and eBGP in tasks.

hostname edge1
!
interface Loopback0
   ip address 10.255.0.31/32
!
interface Ethernet1
   description to core1 10.0.2.1/31
   no switchport
   ip address 10.0.2.1/31
   no shutdown
!
interface Ethernet2
   description to core2 10.0.2.5/31
   no switchport
   ip address 10.0.2.5/31
   no shutdown
!
interface Ethernet3
   description to isp1 203.0.113.0/31
   no switchport
   ip address 203.0.113.0/31
   no shutdown
!
ip routing
!
end
