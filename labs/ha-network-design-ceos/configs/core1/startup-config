! core1 — Core router 1
! Base L3 interfaces only. Configure OSPF/BFD in tasks.

hostname core1
!
interface Loopback0
   ip address 10.255.0.21/32
!
interface Ethernet1
   description to dist1 10.0.1.1/31
   no switchport
   ip address 10.0.1.1/31
   no shutdown
!
interface Ethernet2
   description to dist2 10.0.1.5/31
   no switchport
   ip address 10.0.1.5/31
   no shutdown
!
interface Ethernet3
   description to edge1 10.0.2.0/31
   no switchport
   ip address 10.0.2.0/31
   no shutdown
!
interface Ethernet4
   description to edge2 10.0.2.2/31
   no switchport
   ip address 10.0.2.2/31
   no shutdown
!
ip routing
!
end
