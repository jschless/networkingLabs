! app1 — Simulated application endpoint behind ISPs

hostname app1
!
interface Loopback0
   ip address 172.20.20.20/32
!
interface Ethernet1
   description to isp1 198.51.100.1/31
   no switchport
   ip address 198.51.100.1/31
   no shutdown
!
interface Ethernet2
   description to isp2 198.51.100.3/31
   no switchport
   ip address 198.51.100.3/31
   no shutdown
!
ip route 192.168.10.0/24 198.51.100.0
ip route 192.168.10.0/24 198.51.100.2
ip routing
!
end
