! isp2 — Simulated upstream ISP 2 (AS65102)
! eBGP with edge2 is configured in lab tasks.

hostname isp2
!
interface Loopback0
   ip address 203.255.2.1/32
!
interface Ethernet1
   description to edge2 203.0.113.3/31
   no switchport
   ip address 203.0.113.3/31
   no shutdown
!
interface Ethernet2
   description to app1 198.51.100.2/31
   no switchport
   ip address 198.51.100.2/31
   no shutdown
!
ip route 172.20.20.20/32 198.51.100.3
ip routing
!
end
