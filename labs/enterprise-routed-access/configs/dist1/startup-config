! dist1 — Arista EOS
! Distribution switch, OSPF ABR (area 0 uplinks, area 1 downlink)
! Loopback: 10.0.1.1/32
! Uplinks: core1 (10.1.0.0/31), core2 (10.1.1.0/31) — area 0
! Downlink: acc1 (10.2.0.0/31) — area 1
!
hostname dist1
!
ip routing
!
! ── Loopback ────────────────────────────────────────────────────────────────
interface Loopback0
   description router-id
   ip address 10.0.1.1/32
!
! ── Uplinks to core (area 0) ─────────────────────────────────────────────────
interface Ethernet1
   description to-core1
   no switchport
   ip address 10.1.0.1/31
   no shutdown
!
interface Ethernet2
   description to-core2
   no switchport
   ip address 10.1.1.1/31
   no shutdown
!
! ── Downlink to access (area 1) ──────────────────────────────────────────────
interface Ethernet3
   description to-acc1
   no switchport
   ip address 10.2.0.0/31
   no shutdown
!
! ── OSPF ─────────────────────────────────────────────────────────────────────
! dist1 is an ABR: Loopback in area 0, uplinks in area 0, downlink in area 1.
router ospf 1
   router-id 10.0.1.1
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet2
   no passive-interface Ethernet3
   bfd default
   max-lsa 12000
   network 10.0.1.1/32 area 0.0.0.0
   network 10.1.0.0/31 area 0.0.0.0
   network 10.1.1.0/31 area 0.0.0.0
   network 10.2.0.0/31 area 0.0.0.1
   area 0.0.0.1 stub
!
end
