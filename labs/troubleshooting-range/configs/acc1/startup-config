hostname acc1
ip routing
vlan 10
   name CORPORATE
vlan 20
   name VOICE
interface Loopback0
   ip address 10.250.255.11/32
interface Ethernet1
   description to-core1
   no switchport
   ip address 10.250.0.1/31
   no shutdown
interface Ethernet2
   description to-core2
   no switchport
   ip address 10.250.0.3/31
   no shutdown
interface Ethernet3
   description to-corp1
   switchport access vlan 10
   switchport mode access
   spanning-tree portfast
   no shutdown
interface Ethernet4
   description to-voice1
   switchport access vlan 20
   switchport mode access
   spanning-tree portfast
   no shutdown
interface Vlan10
   ip address 10.250.10.1/24
   no shutdown
interface Vlan20
   ip address 10.250.20.1/24
   no shutdown
router ospf 1
   router-id 10.250.255.11
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet2
   network 10.250.0.0/31 area 0.0.0.0
   network 10.250.0.2/31 area 0.0.0.0
   network 10.250.10.0/24 area 0.0.0.0
   network 10.250.20.0/24 area 0.0.0.0
   network 10.250.255.11/32 area 0.0.0.0
end
