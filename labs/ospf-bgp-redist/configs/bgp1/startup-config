hostname bgp1
!
ip routing
!
interface Loopback0
   ip address 10.0.0.3/32
!
interface Ethernet1
   description to asbr (AS65100) — eBGP
   no switchport
   ip address 10.0.23.2/30
!
interface Ethernet2
   description to bgp2 (AS65200) — iBGP
   no switchport
   ip address 10.0.34.1/30
!
! ── Task: Configure eBGP to asbr and iBGP to bgp2 ───────────────────────────
! bgp1 is in AS65200. Peers: asbr at 10.0.23.1 (AS65100 eBGP), bgp2 at 10.0.34.2 (iBGP).
! Must use next-hop-self for bgp2 so it can reach eBGP next-hops.
!
! router bgp 65200
!    bgp router-id 10.0.0.3
!    neighbor 10.0.23.1 remote-as 65100
!    neighbor 10.0.34.2 remote-as 65200
!    !
!    address-family ipv4
!       neighbor 10.0.23.1 activate
!       neighbor 10.0.34.2 activate
!       neighbor 10.0.34.2 next-hop-self
!       network 10.0.0.3/32
!    !
! !
end
