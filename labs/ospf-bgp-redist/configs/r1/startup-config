hostname r1
!
ip routing
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to asbr — OSPF area 0
   no switchport
   ip address 10.0.12.1/30
!
! ── Task: Configure OSPF ─────────────────────────────────────────────────────
! r1 runs OSPF only (no BGP). Advertise loopback and the link subnet.
!
! router ospf 1
!    router-id 10.0.0.1
!    passive-interface Loopback0
!    network 10.0.0.1/32 area 0.0.0.0
!    network 10.0.12.0/30 area 0.0.0.0
! !
end
