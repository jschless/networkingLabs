! spine1 — AS65100  (Arista EOS)
!
! Spines are fully pre-configured.
! They handle:
!   - eBGP underlay: distribute leaf loopbacks across the fabric
!   - eBGP EVPN: pass type-2/3/5 routes between leaves using next-hop-unchanged
!     so that the VTEP IP (leaf loopback) is preserved end-to-end.
!
! next-hop-unchanged is the key: without it, the spine would replace the
! EVPN next-hop with its own interface IP, breaking VXLAN tunnel formation.
!
hostname spine1
!
interface Loopback0
   ip address 10.0.0.101/32
!
interface Ethernet1
   description to leaf1  10.1.0.0/31
   no switchport
   ip address 10.1.0.1/31
   no shutdown
!
interface Ethernet2
   description to leaf2  10.1.0.2/31
   no switchport
   ip address 10.1.0.3/31
   no shutdown
!
interface Ethernet3
   description to leaf3  10.1.0.4/31
   no switchport
   ip address 10.1.0.5/31
   no shutdown
!
interface Ethernet4
   description to leaf4  10.1.0.6/31
   no switchport
   ip address 10.1.0.7/31
   no shutdown
!
ip routing
!
router bgp 65100
   router-id 10.0.0.101
   maximum-paths 4 ecmp 4
   bgp bestpath as-path multipath-relax
   !
   neighbor 10.1.0.0 remote-as 65001
   neighbor 10.1.0.2 remote-as 65002
   neighbor 10.1.0.4 remote-as 65003
   neighbor 10.1.0.6 remote-as 65004
   !
   address-family ipv4
      neighbor 10.1.0.0 activate
      neighbor 10.1.0.2 activate
      neighbor 10.1.0.4 activate
      neighbor 10.1.0.6 activate
      network 10.0.0.101/32
   !
   address-family evpn
      neighbor 10.1.0.0 activate
      neighbor 10.1.0.2 activate
      neighbor 10.1.0.4 activate
      neighbor 10.1.0.6 activate
      neighbor 10.1.0.0 next-hop-unchanged
      neighbor 10.1.0.2 next-hop-unchanged
      neighbor 10.1.0.4 next-hop-unchanged
      neighbor 10.1.0.6 next-hop-unchanged
!
end
