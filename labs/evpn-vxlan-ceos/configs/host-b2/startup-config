! host-b2 — Tenant-B server  (Arista EOS acting as end host)
! IP: 10.20.20.12/24,  gateway: 10.20.20.1 (anycast IRB on leaf4)
! Connected to: leaf4 Ethernet3 (access VLAN 20)
!
hostname host-b2
!
interface Ethernet1
   description to leaf4 (VLAN 20, Tenant-B)
   no switchport
   ip address 10.20.20.12/24
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 10.20.20.1
!
end
