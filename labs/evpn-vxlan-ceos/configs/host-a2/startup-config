! host-a2 — Tenant-A server  (Arista EOS acting as end host)
! IP: 10.10.10.12/24,  gateway: 10.10.10.1 (anycast IRB on leaf3)
! Connected to: leaf3 Ethernet3 (access VLAN 10)
!
hostname host-a2
!
interface Ethernet1
   description to leaf3 (VLAN 10, Tenant-A)
   no switchport
   ip address 10.10.10.12/24
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 10.10.10.1
!
end
