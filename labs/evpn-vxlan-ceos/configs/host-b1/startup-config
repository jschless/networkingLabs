! host-b1 — Tenant-B server  (Arista EOS acting as end host)
! IP: 10.20.20.11/24,  gateway: 10.20.20.1 (anycast IRB on leaf2)
! Connected to: leaf2 Ethernet3 (access VLAN 20)
!
hostname host-b1
!
interface Ethernet1
   description to leaf2 (VLAN 20, Tenant-B)
   no switchport
   ip address 10.20.20.11/24
   no shutdown
!
ip routing
!
ip route 0.0.0.0/0 10.20.20.1
!
end
