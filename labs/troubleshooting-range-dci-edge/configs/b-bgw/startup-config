hostname b-bgw
no aaa root
ip routing
vrf instance PROD
ip routing vrf PROD
vlan 10
interface Loopback0
 ip address 10.20.0.3/32
interface Ethernet1
 no switchport
 description to b-leaf 10.21.0.0/30
 ip address 10.21.0.1/30
interface Ethernet2
 no switchport
 description routed DCI to a-bgw
 ip address 10.255.10.2/30
interface Vlan10
 vrf PROD
 ip address virtual 172.17.10.1/24
 no autostate
interface Vxlan1
 vxlan source-interface Loopback0
 vxlan udp-port 4789
 vxlan vlan 10 vni 10010
 vxlan vrf PROD vni 50010
ip virtual-router mac-address 00:1c:73:dc:10:01
ip route 10.10.0.0/24 10.255.10.1
ip extcommunity-list DCI-PROD permit rt 65020:50010
route-map DCI-PROD permit 10
 match extcommunity DCI-PROD
route-map DCI-PROD deny 100
router bgp 65022
 router-id 10.20.0.3
 neighbor 10.21.0.2 remote-as 65021
 neighbor 10.21.0.2 send-community extended
 neighbor 10.255.10.1 remote-as 65012
 neighbor 10.255.10.1 send-community extended
 address-family ipv4
  neighbor 10.21.0.2 activate
  neighbor 10.255.10.1 activate
  network 10.20.0.3/32
 address-family evpn
  neighbor 10.21.0.2 activate
  neighbor 10.21.0.2 next-hop-unchanged
  neighbor 10.255.10.1 activate
  neighbor 10.255.10.1 route-map DCI-PROD out
 vlan 10
  rd auto
  route-target both 65020:10010
  redistribute learned
 vrf PROD
  rd 10.20.0.3:50010
  route-target import evpn 65010:50010
  route-target import evpn 65020:50010
  route-target export evpn 65020:50010
  redistribute connected
end
