hostname r3
!
ip routing
!
interface Loopback0
   ip address 10.0.0.3/32
!
interface Ethernet1
   no switchport
   ip address 10.1.23.2/30
!
interface Ethernet2
   no switchport
   ip address 10.1.34.1/30
!
ip as-path access-list ONLY-65001 permit _65001$
!
router bgp 65003
   bgp router-id 10.0.0.3
   neighbor 10.1.23.1 remote-as 65002
   neighbor 10.1.34.2 remote-as 65004
   !
   address-family ipv4
      neighbor 10.1.23.1 activate
      neighbor 10.1.23.1 filter-list ONLY-65001 in
      neighbor 10.1.34.2 activate
      network 10.0.0.3/32
   !
!
end
