hostname r4
!
ip routing
!
interface Loopback0
   ip address 10.0.0.4/32
!
interface Ethernet1
   no switchport
   ip address 10.1.34.2/30
!
router bgp 65004
   bgp router-id 10.0.0.4
   neighbor 10.1.34.1 remote-as 65003
   !
   address-family ipv4
      neighbor 10.1.34.1 activate
      network 10.0.0.4/32
   !
!
end
