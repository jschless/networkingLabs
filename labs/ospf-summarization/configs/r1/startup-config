hostname r1
!
ip routing
!
! ============================================================
! r1 — stub router in Area 1
! Topology: [r1] --Area1-- [r2(ABR)] --Area0-- [r3(ASBR)] --Area2-- [r4]
!
! r1 has THREE loopback addresses in the 10.1.0.0/22 range.
! After configuring summarization on r2, all three will be hidden
! behind a single Type-3 summary LSA (10.1.0.0/22) in area 0.
! ============================================================

interface Loopback0
 ! Primary loopback — part of the 10.1.0.0/22 block
 ip address 10.1.1.1/32

! Add two more addresses to Loopback0 to simulate a range of area 1 prefixes:
!   ip address 10.1.2.1/32
!   ip address 10.1.3.1/32
! Hint: in FRR vtysh:
!   interface Loopback0
!    ip address 10.1.2.1/32
!    ip address 10.1.3.1/32

! Link to r2 — segment 10.1.12.0/30 — this link is in area 1
! r1 is .1, r2 is .2 on this segment
interface Ethernet1
 no switchport
 description Link to r2 (10.1.12.0/30, r1=.1 r2=.2) — OSPF area 1
 ip address 10.1.12.1/30

! ============================================================
! TODO: Configure OSPF
!
! r1 is a regular router entirely within area 1.
! All its prefixes (loopbacks + Ethernet1) go into area 1.
!
!   router ospf 1
!    ospf router-id 10.1.1.1
!    network 10.1.1.1/32 area 1
!    network 10.1.2.1/32 area 1      ! add after creating on Loopback0
!    network 10.1.3.1/32 area 1      ! add after creating on Loopback0
!    network 10.1.12.0/30 area 1
!    passive-interface Loopback0
!
! After configuring r2 summarization, verify from r3 or r4 that
! you see ONLY 10.1.0.0/22 (not individual /32s) in the OSPF database:
!   show ip ospf database summary      ! Type-3 LSAs
!   show ip route ospf
! ============================================================
