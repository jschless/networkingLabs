hostname r4
!
ip routing
!
! ============================================================
! r4 — stub router in Area 2
! Topology: [r1] --Area1-- [r2(ABR)] --Area0-- [r3(ASBR)] --Area2-- [r4]
!
! r4 is the best vantage point for observing summarization effects:
!  - From here, look for O IA (inter-area) routes from area 1
!  - From here, look for O E2 (external) routes from the ext node
!  - After summarization: fewer, larger prefixes should appear
! ============================================================

interface Loopback0
 ! r4 loopback is in area 2
 ip address 10.2.0.1/32

! Link to r3 — segment 10.1.34.0/30 — in OSPF area 2
! r3 is .1, r4 is .2
interface Ethernet1
 no switchport
 description Link to r3 (10.1.34.0/30, r3=.1 r4=.2) — OSPF area 2
 ip address 10.1.34.2/30

! ============================================================
! TODO: Configure OSPF
!
!   router ospf 1
!    ospf router-id 10.2.0.1
!    network 10.2.0.1/32 area 2
!    network 10.1.34.0/30 area 2
!    passive-interface Loopback0
!
! r4 is a good verification point. After full configuration, run:
!
!   show ip ospf database
!     Before summarization: you'll see many Type-3 LSAs (one per /32 from r1)
!     After summarization at r2: only ONE Type-3 LSA for 10.1.0.0/22
!
!   show ip ospf database external
!     Before summarization at r3: individual Type-5 LSAs
!     After summary-address on r3: single Type-5 LSA for 192.168.100.0/24
!
!   show ip route ospf
!     O IA = inter-area routes (from other areas via Type-3 LSAs)
!     O E2 = external routes (redistributed via Type-5 LSAs)
! ============================================================
