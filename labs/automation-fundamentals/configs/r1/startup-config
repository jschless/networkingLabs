hostname r1
!
! -------------------------------------------------------
! Node: r1  (eBGP peer, AS 65001)
!
! Addressing, BGP, and the admin user are pre-configured —
! this lab is about driving the box through its API, not
! about building the routing.
!
! What you need to configure here (Task 2):
!   - Enable the eAPI HTTP server (management api http-commands)
! Hint:
!   management api http-commands
!      no shutdown
!      protocol http
! -------------------------------------------------------
!
no aaa root
!
username admin privilege 15 role network-admin secret admin
!
ip routing
!
interface Loopback0
   ip address 10.0.0.1/32
!
interface Ethernet1
   description to r2 Ethernet1
   no switchport
   ip address 10.1.12.1/30
   no shutdown
!
router bgp 65001
   router-id 10.0.0.1
   neighbor 10.1.12.2 remote-as 65002
   !
   address-family ipv4
      neighbor 10.1.12.2 activate
      network 10.0.0.1/32
   !
!
end
