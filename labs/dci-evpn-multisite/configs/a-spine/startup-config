hostname a-spine
no aaa root
ip routing
interface Loopback0
 ip address 10.10.0.2/32
interface Ethernet1
 no switchport
 description to a-leaf 10.11.0.0/30
 ip address 10.11.0.2/30
interface Ethernet2
 no switchport
 description to a-bgw 10.11.0.4/30
 ip address 10.11.0.6/30
router bgp 65110
 router-id 10.10.0.2
 neighbor 10.11.0.1 remote-as 65011
 neighbor 10.11.0.1 send-community extended
 neighbor 10.11.0.5 remote-as 65012
 neighbor 10.11.0.5 send-community extended
 address-family ipv4
  neighbor 10.11.0.1 activate
  neighbor 10.11.0.5 activate
 address-family evpn
  neighbor 10.11.0.1 activate
  neighbor 10.11.0.5 activate
  neighbor 10.11.0.1 next-hop-unchanged
  neighbor 10.11.0.5 next-hop-unchanged
end
