hostname a-bgw
no aaa root
ip routing
vrf instance PROD
ip routing vrf PROD
vlan 10
vlan 30
interface Loopback0
 ip address 10.10.0.3/32
interface Ethernet1
 no switchport
 description to a-spine 10.11.0.4/30
 ip address 10.11.0.5/30
interface Ethernet2
 no switchport
 description to b-bgw DCI 10.255.10.0/30
 ip address 10.255.10.1/30
interface Ethernet3
 description a-app shared service
 switchport access vlan 30
interface Vlan10
 vrf PROD
 ip address virtual 172.16.10.1/24
 no autostate
interface Vlan30
 vrf PROD
 ip address virtual 172.31.10.1/24
 no autostate
interface Vxlan1
 vxlan source-interface Loopback0
 vxlan udp-port 4789
 vxlan vlan 10 vni 10010
 vxlan vrf PROD vni 50010
ip virtual-router mac-address 00:1c:73:dc:10:01
router bgp 65012
 router-id 10.10.0.3
 neighbor 10.11.0.6 remote-as 65110
 neighbor 10.11.0.6 send-community extended
 address-family ipv4
  neighbor 10.11.0.6 activate
  network 10.10.0.3/32
 address-family evpn
  neighbor 10.11.0.6 activate
 vlan 10
  rd auto
  route-target both 65010:10010
  redistribute learned
 vrf PROD
  rd 10.10.0.3:50010
  route-target import evpn 65010:50010
  route-target export evpn 65010:50010
  redistribute connected
end
