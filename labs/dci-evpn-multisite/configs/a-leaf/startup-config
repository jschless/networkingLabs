hostname a-leaf
no aaa root
ip routing
vrf instance PROD
vrf instance DEV
ip routing vrf PROD
ip routing vrf DEV
vlan 10
vlan 20
interface Loopback0
 ip address 10.10.0.1/32
interface Ethernet1
 no switchport
 description to a-spine 10.11.0.0/30
 ip address 10.11.0.1/30
interface Ethernet3
 description a-client PROD
 switchport access vlan 10
interface Ethernet4
 description a-client DEV
 switchport access vlan 20
interface Vlan10
 vrf PROD
 ip address virtual 172.16.10.1/24
 no autostate
interface Vlan20
 vrf DEV
 ip address virtual 172.16.20.1/24
 no autostate
interface Vxlan1
 vxlan source-interface Loopback0
 vxlan udp-port 4789
 vxlan vlan 10 vni 10010
 vxlan vlan 20 vni 10020
 vxlan vrf PROD vni 50010
 vxlan vrf DEV vni 50020
ip virtual-router mac-address 00:1c:73:dc:10:01
router bgp 65011
 router-id 10.10.0.1
 neighbor 10.11.0.2 remote-as 65110
 neighbor 10.11.0.2 send-community extended
 address-family ipv4
  neighbor 10.11.0.2 activate
  network 10.10.0.1/32
 address-family evpn
  neighbor 10.11.0.2 activate
 vlan 10
  rd auto
  route-target both 65010:10010
  redistribute learned
 vlan 20
  rd auto
  route-target both 65010:10020
  redistribute learned
 vrf PROD
  rd 10.10.0.1:50010
  route-target import evpn 65010:50010
  route-target export evpn 65010:50010
  redistribute connected
 vrf DEV
  rd 10.10.0.1:50020
  route-target import evpn 65010:50020
  route-target export evpn 65010:50020
  redistribute connected
end
