# ContainerLab runtime directories (created when labs are deployed)
clab-*/
labs/*/clab-*/

# ContainerLab generated files
# *.clab.yml
.clab_cache/

# FRR runtime files that may appear in bind-mounted config dirs
*.pid
*.log
*.sock
frr.log

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Shell history / scratch files
*.bak
*.tmp

# MkDocs generated site
site/

# NetBox automation lab runtime artifacts
labs/network-automation-netbox/automation/__pycache__/
labs/network-automation-netbox/automation/generated/
labs/network-automation-netbox/automation/backups/
labs/network-automation-netbox/automation/facts/

# Security infrastructure lab runtime artifacts
labs/soc-*/runtime/
labs/soc-*/pcap/
labs/soc-*/logs/
labs/soc-*/data/
